+/*
+ * Copyright (C) 2026 the Lumia port. All rights reserved.
+ *
+ * F2.c: where the Web thread's time goes.
+ *
+ * The run loop times every task it executes; inside a task a few labeled scopes accumulate their own wall time
+ * (script, style, layout, parser, timer, render, the port's own work). A task longer than longTaskMs is reported as
+ * one line naming the heaviest scopes, and every summaryMs a line reports how much of the window the thread was busy
+ * and on what. That turns "the page blocks for half a second" into "512.3 ms: js 380.0, layout 100.2".
+ *
+ * The observer is a plain function pointer that the port sets at lw_init: WTF must not know about the app or its log.
+ * With no observer every entry point is one relaxed atomic load, so the calls can stay in the hot paths.
+ *
+ * Scopes nest deliberately: each one counts its own wall time, so an outer scope (render) also contains the inner ones
+ * it triggers (style, layout). Reading a long-task line: the outermost label that covers the whole duration is the
+ * frame of reference, the inner ones say where the time went inside it.
+ */
+
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <wtf/MonotonicTime.h>
+#include <wtf/Noncopyable.h>
+
+namespace WTF {
+
+enum class Activity : uint8_t {
+    Script,
+    Style,
+    Layout,
+    Parser,
+    Timer,
+    Render,
+    Port,
+    Count
+};
+
+class ActivityRecorder {
+    WTF_MAKE_NONCOPYABLE(ActivityRecorder);
+public:
+    using Observer = void (*)(const char* line);
+
+    static constexpr unsigned count = static_cast<unsigned>(Activity::Count);
+    // A task longer than this is one the finger feels: half a frame at 60 Hz is 8 ms, and three frames is already
+    // visible in a scroll.
+    static constexpr double longTaskMs = 30;
+    static constexpr double summaryMs = 2000;
+    // Under a page that blocks continuously the log would otherwise carry thousands of identical lines; the summary
+    // keeps counting what the rate limit hides.
+    static constexpr unsigned maxLongTaskLines = 6;
+
+    static void setObserver(Observer observer)
+    {
+        s_observer.store(observer, std::memory_order_relaxed);
+        // Switched off in the middle of a task, the thread will not report its end.
+        if (!observer)
+            s_taskStart.store(0, std::memory_order_relaxed);
+    }
+
+    // Which thread a report came from. The port names its Web thread ("web") at the top of webThreadMain; every other
+    // run loop in the process (compositor, scrolling, raster) is left almost unnamed on purpose — see enabled().
+    static void setThreadTag(const char* tag)
+    {
+        threadState().tag = tag;
+    }
+
+    // Measurement is on only where both the tracer and a name exist: the app's Web thread. The other loops run work
+    // that this instrument is not about, and they would pay two clock reads per task plus a log line every 2 s.
+    static bool enabled()
+    {
+        return s_observer.load(std::memory_order_relaxed) && threadState().tag;
+    }
+
+    // Around each function the run loop executes. The queue depths are what the loop saw when it took the task: a
+    // long task with 40 tasks already waiting is a different problem from a long task on an empty queue.
+    static void beginTask(unsigned pendingInput, unsigned pendingNormal, unsigned pendingLow)
+    {
+        if (!enabled())
+            return;
+        auto& state = threadState();
+        // A nested run loop (sync XHR, alert, modal dialogs) executes more functions while an outer function is still
+        // on the stack: they are part of the outer task, so they must neither reset its start time nor its scopes.
+        if (state.depth++)
+            return;
+        auto now = MonotonicTime::now();
+        if (!state.windowStart)
+            state.windowStart = now;
+        state.taskStart = now;
+        s_taskStart.store(now.secondsSinceEpoch().value(), std::memory_order_relaxed);
+        state.pendingInput = pendingInput;
+        state.pendingNormal = pendingNormal;
+        state.pendingLow = pendingLow;
+        for (double& ms : state.taskMs)
+            ms = 0;
+    }
+
+    static void endTask()
+    {
+        if (!enabled())
+            return;
+        auto& state = threadState();
+        if (!state.depth || --state.depth)
+            return;
+        s_taskStart.store(0, std::memory_order_relaxed);
+        auto now = MonotonicTime::now();
+        double total = (now - state.taskStart).milliseconds();
+
+        state.windowBusyMs += total;
+        state.windowTasks++;
+        for (unsigned i = 0; i < count; ++i)
+            state.windowMs[i] += state.taskMs[i];
+
+        if (total >= longTaskMs) {
+            state.windowLongTasks++;
+            if (state.longTaskLines < maxLongTaskLines) {
+                state.longTaskLines++;
+                reportLongTask(state, total);
+            }
+        }
+
+        if ((now - state.windowStart).milliseconds() >= summaryMs)
+            reportSummary(state, now);
+    }
+
+    // Any thread: when the task the measured thread (the Web thread) is running began, 0 between tasks. The port's hang
+    // sampler polls it: a task that has run too long gets its stack sampled.
+    static MonotonicTime currentTaskStart()
+    {
+        return MonotonicTime::fromRawSeconds(s_taskStart.load(std::memory_order_relaxed));
+    }
+
+    // Time consumed by one labeled piece of work inside the current task. Called by Scope on destruction; the
+    // millisecond value is what the scope measured, not a difference of counters, because scopes nest.
+    static void add(Activity activity, double milliseconds)
+    {
+        if (!enabled())
+            return;
+        threadState().taskMs[static_cast<unsigned>(activity)] += milliseconds;
+    }
+
+    class Scope {
+        WTF_MAKE_NONCOPYABLE(Scope);
+    public:
+        explicit Scope(Activity activity)
+            : m_activity(activity)
+        {
+            if (enabled()) {
+                m_start = MonotonicTime::now();
+                m_active = true;
+                // A scope inside another of its own kind (updateStyleIfNeeded around resolveStyle, a layout that
+                // lays out a subframe) is already in the outer one's time: counted once, not twice.
+                m_outermost = !threadState().nesting[static_cast<unsigned>(activity)]++;
+            }
+        }
+
+        ~Scope()
+        {
+            if (!m_active)
+                return;
+            auto& nesting = threadState().nesting[static_cast<unsigned>(m_activity)];
+            if (nesting)
+                --nesting;
+            if (m_outermost)
+                add(m_activity, (MonotonicTime::now() - m_start).milliseconds());
+        }
+
+    private:
+        Activity m_activity;
+        MonotonicTime m_start;
+        bool m_active { false };
+        bool m_outermost { false };
+    };
+
+private:
+    struct State {
+        const char* tag { nullptr };
+        unsigned depth { 0 };
+        MonotonicTime taskStart;
+        unsigned pendingInput { 0 };
+        unsigned pendingNormal { 0 };
+        unsigned pendingLow { 0 };
+        double taskMs[count] { };
+        unsigned nesting[count] { };
+
+        MonotonicTime windowStart;
+        double windowBusyMs { 0 };
+        double windowMs[count] { };
+        unsigned windowTasks { 0 };
+        unsigned windowLongTasks { 0 };
+        unsigned longTaskLines { 0 };
+    };
+
+    static State& threadState()
+    {
+        static thread_local State state;
+        return state;
+    }
+
+    static const char* name(Activity activity)
+    {
+        switch (activity) {
+        case Activity::Script: return "js";
+        case Activity::Style: return "style";
+        case Activity::Layout: return "layout";
+        case Activity::Parser: return "parser";
+        case Activity::Timer: return "timer";
+        case Activity::Render: return "render";
+        case Activity::Port: return "port";
+        default: return "?";
+        }
+    }
+
+    // Heaviest first, so the label that explains the task is the first one read. Insertion sort over at most seven
+    // entries, only when a long task is reported.
+    static void sortDescending(double (&ms)[count], unsigned (&order)[count], unsigned& used)
+    {
+        used = 0;
+        for (unsigned i = 0; i < count; ++i) {
+            if (ms[i] <= 0)
+                continue;
+            unsigned at = used;
+            while (at > 0 && ms[order[at - 1]] < ms[i]) {
+                order[at] = order[at - 1];
+                --at;
+            }
+            order[at] = i;
+            ++used;
+        }
+    }
+
+    static void reportLongTask(State& state, double total)
+    {
+        unsigned order[count] { };
+        unsigned used = 0;
+        sortDescending(state.taskMs, order, used);
+
+        char line[320];
+        int written = snprintf(line, sizeof line, "attivita': [%s] task %.1f ms (coda %u/%u/%u)",
+            state.tag, total, state.pendingInput, state.pendingNormal, state.pendingLow);
+        for (unsigned i = 0; i < used && i < 5 && written > 0 && written < static_cast<int>(sizeof line) - 32; ++i) {
+            unsigned at = order[i];
+            written += snprintf(line + written, sizeof line - written, " %s %.1f",
+                name(static_cast<Activity>(at)), state.taskMs[at]);
+        }
+        emit(line);
+    }
+
+    static void reportSummary(State& state, MonotonicTime now)
+    {
+        double window = (now - state.windowStart).milliseconds();
+        char line[400];
+        int written = snprintf(line, sizeof line, "attivita': [%s] occupato %.1f/%.0f ms (%.0f%%), task %u, lunghi %u",
+            state.tag, state.windowBusyMs, window, window > 0 ? 100.0 * state.windowBusyMs / window : 0.0,
+            state.windowTasks, state.windowLongTasks);
+        for (unsigned i = 0; i < count && written > 0 && written < static_cast<int>(sizeof line) - 24; ++i) {
+            if (state.windowMs[i] <= 0)
+                continue;
+            written += snprintf(line + written, sizeof line - written, " %s %.0f",
+                name(static_cast<Activity>(i)), state.windowMs[i]);
+        }
+        emit(line);
+
+        state.windowStart = now;
+        state.windowBusyMs = 0;
+        for (double& ms : state.windowMs)
+            ms = 0;
+        state.windowTasks = 0;
+        state.windowLongTasks = 0;
+        state.longTaskLines = 0;
+    }
+
+    static void emit(const char* line)
+    {
+        if (auto observer = s_observer.load(std::memory_order_relaxed))
+            observer(line);
+    }
+
+    static inline std::atomic<Observer> s_observer { nullptr };
+    // Only the measured thread writes it (enabled() needs its tag).
+    static inline std::atomic<double> s_taskStart { 0 };
+};
+
+} // namespace WTF
