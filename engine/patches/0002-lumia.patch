+    private:
+        Activity m_activity;
+        MonotonicTime m_start;
+        bool m_active { false };
+        bool m_outermost { false };
+    };
+
+private:
+    struct State {
+        const char* tag { nullptr };
+        unsigned depth { 0 };
+        MonotonicTime taskStart;
+        unsigned pendingInput { 0 };
+        unsigned pendingNormal { 0 };
+        unsigned pendingLow { 0 };
+        double taskMs[count] { };
+        unsigned nesting[count] { };
+
+        MonotonicTime windowStart;
+        double windowBusyMs { 0 };
+        double windowMs[count] { };
+        unsigned windowTasks { 0 };
+        unsigned windowLongTasks { 0 };
+        unsigned longTaskLines { 0 };
+    };
+
+    static State& threadState()
+    {
+        static thread_local State state;
+        return state;
+    }
+
+    static const char* name(Activity activity)
+    {
+        switch (activity) {
+        case Activity::Script: return "js";
+        case Activity::Style: return "style";
+        case Activity::Layout: return "layout";
+        case Activity::Parser: return "parser";
+        case Activity::Timer: return "timer";
+        case Activity::Render: return "render";
+        case Activity::Port: return "port";
+        default: return "?";
+        }
+    }
