+static String sniffedMIMEType(std::span<const uint8_t> data)
+{
+    if (data.size() >= 3 && data[0] == 0xEF && data[1] == 0xBB && data[2] == 0xBF)
+        data = data.subspan(3);
+    size_t start = 0;
+    while (start < data.size() && (data[start] == ' ' || data[start] == '\t' || data[start] == '\r' || data[start] == '\n' || data[start] == '\f'))
+        start++;
+    auto body = data.subspan(start);
+    auto startsWith = [&](ASCIILiteral tag) {
+        auto bytes = tag.span8();
+        if (body.size() < bytes.size())
+            return false;
+        for (size_t i = 0; i < bytes.size(); i++) {
+            if (toASCIILower(body[i]) != static_cast<uint8_t>(bytes[i]))
+                return false;
+        }
+        return true;
+    };
