+/*
+ * The Lumia port's JavaScript bytecode cache.
+ *
+ * JSC can write down what it compiles (CachedTypes: a script's unlinked program code block, then each function's as it
+ * is first called) and read it back lazily, through four hooks of JSC::SourceProvider. The jsc shell
+ * (--diskCachePath) and the JSScript API use them; WebCore never did, so every visit to a page parsed and compiled
+ * the same megabytes of script again (Gmail: 15% of the Web thread in lazy function compilation alone, PLAN.md §56).
+ * Here the scripts of pages use them: external scripts (CachedScriptSourceProvider) and large inline ones
+ * (ScriptBytecodeCachingProvider below).
+ *
+ * A file is found by a keyed hash of the script's text (the key being secret to the phone), and JSC decodes it only
+ * when the length and its own hash of the text match too: the file holds no copy of the text (CachedTypes.cpp).
+ *
+ * Storage, keys and policy are the port's (port/BytecodeCache.cpp), which defines what is declared here. Main thread
+ * only: workers keep JSC's plain providers.
+ */
+
+#pragma once
+
+#if defined(WP81)
+
+#include <JavaScriptCore/SourceProvider.h>
+#include <memory>
+#include <wtf/text/WTFString.h>
+
+namespace JSC {
+class CachedBytecode;
+class UnlinkedFunctionCodeBlock;
+class UnlinkedFunctionExecutable;
+}
+
+namespace WebCore {
+
+// One script's side of the cache, behind JSC's hooks. What it keeps (the file read, the functions compiled since, the
+// file they are written on top of) is the port's ScriptBytecodeCacheState::Script, made by the first hook that finds the
+// script worth caching: most scripts never get one.
+class ScriptBytecodeCacheState {
+public:
+    // External scripts are stored the first time they run (their URLs make them stable); inline ones the second time
+    // the same text runs (a page's inline scripts often carry per-visit data and would never be met again).
+    enum class Origin : uint8_t { External, Inline };
+    struct Script;
+
+    // Both in the port, where Script is complete (the MSVC ABI destroys members from the constructor too).
+    explicit ScriptBytecodeCacheState(Origin);
+    ~ScriptBytecodeCacheState();
+
+    RefPtr<JSC::CachedBytecode> cachedBytecode(const JSC::SourceProvider&) const;
+    void cacheBytecode(const JSC::SourceProvider&, const JSC::BytecodeCacheGenerator&) const;
+    void updateCache(const JSC::SourceProvider&, const JSC::UnlinkedFunctionExecutable*, JSC::CodeSpecializationKind, const JSC::UnlinkedFunctionCodeBlock*) const;
+
+private:
+    Script* script(const JSC::SourceProvider&) const;
+
+    mutable std::unique_ptr<Script> m_script;
+    mutable bool m_checked { false };
+    const Origin m_origin;
+};
+
+// An inline script large enough to be worth caching (shouldCacheInlineScriptBytecode).
+class ScriptBytecodeCachingProvider final : public JSC::StringSourceProvider {
+public:
+    static Ref<ScriptBytecodeCachingProvider> create(const String& source, const JSC::SourceOrigin& sourceOrigin, String sourceURL, JSC::SourceTaintedOrigin taintedness, const TextPosition& startPosition, JSC::SourceProviderSourceType sourceType)
+    {
+        return adoptRef(*new ScriptBytecodeCachingProvider(source, sourceOrigin, taintedness, WTF::move(sourceURL), startPosition, sourceType));
+    }
+
+    RefPtr<JSC::CachedBytecode> cachedBytecode() const final { return m_bytecodeCache.cachedBytecode(*this); }
+    void cacheBytecode(const JSC::BytecodeCacheGenerator& generator) const final { m_bytecodeCache.cacheBytecode(*this, generator); }
+    void updateCache(const JSC::UnlinkedFunctionExecutable* executable, const JSC::SourceCode&, JSC::CodeSpecializationKind kind, const JSC::UnlinkedFunctionCodeBlock* codeBlock) const final
+    {
+        m_bytecodeCache.updateCache(*this, executable, kind, codeBlock);
+    }
+
+private:
+    ScriptBytecodeCachingProvider(const String& source, const JSC::SourceOrigin& sourceOrigin, JSC::SourceTaintedOrigin taintedness, String&& sourceURL, const TextPosition& startPosition, JSC::SourceProviderSourceType sourceType)
+        : StringSourceProvider(source, sourceOrigin, taintedness, WTF::move(sourceURL), startPosition, sourceType)
+    {
+    }
+
+    ScriptBytecodeCacheState m_bytecodeCache { ScriptBytecodeCacheState::Origin::Inline };
+};
+
+// ScriptSourceCode, for an inline script: whether it gets a caching provider (main thread, cache on, large enough).
+bool shouldCacheInlineScriptBytecode(const String& source, JSC::SourceProviderSourceType);
+
+} // namespace WebCore
