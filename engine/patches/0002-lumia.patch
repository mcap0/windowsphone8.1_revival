+        for (auto& buffer : held) {
+            handle->client()->didReceiveBuffer(handle.ptr(), buffer.get(), buffer->size());
+            if (d.m_cancelled || d.m_curlRequest != request.ptr())
+                return;
+        }
+        if (completion)
