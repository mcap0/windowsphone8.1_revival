+int32_t Value::asI64hi() const
+{
+    ASSERT(m_kind == Const);
+    return m_i32_pair.hi;
+}
+
+int32_t Value::asI64lo() const
+{
+    ASSERT(m_kind == Const);
+    return m_i32_pair.lo;
+}
