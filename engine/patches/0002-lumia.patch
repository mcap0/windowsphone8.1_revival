+#include "ICCensus.h"
 
 namespace JSC {
 
+namespace ICCensus {
+
+std::atomic<bool> enabled;
+
+namespace {
+
+constexpr unsigned slotCount = 4096;
+constexpr unsigned lineCount = 4096;
+constexpr unsigned resultCount = 8;
+
+struct Slot {
+    std::atomic<const void*> cache;
+    unsigned calls;
+    unsigned outcomes[OutcomeCount];
+    unsigned lastLine;
+    char name[28];
+};
+
+Slot s_slots[slotCount];
+std::atomic<unsigned> s_outcomes[OutcomeCount];
+std::atomic<unsigned> s_lines[lineCount];
+std::atomic<unsigned> s_results[resultCount];
+std::atomic<unsigned> s_overflow;
+thread_local Slot* t_slot;
+
+}
+
+void noteGetById(const void* cache, UniquedStringImpl* name, Outcome outcome)
+{
+    s_outcomes[outcome].fetch_add(1, std::memory_order_relaxed);
+    t_slot = nullptr;
+    unsigned hash = static_cast<unsigned>(reinterpret_cast<uintptr_t>(cache) >> 2) * 2654435761u;
+    for (unsigned probe = 0; probe < 64; ++probe) {
+        Slot& slot = s_slots[(hash + probe) & (slotCount - 1)];
+        const void* current = slot.cache.load(std::memory_order_relaxed);
+        if (!current && slot.cache.compare_exchange_strong(current, cache)) {
+            CString utf8 = name ? String(name).utf8() : CString("?");
+            strncpy_s(slot.name, sizeof(slot.name), utf8.data(), _TRUNCATE);
+            current = cache;
+        }
+        if (current != cache)
+            continue;
+        slot.calls++;
+        slot.outcomes[outcome]++;
+        if (outcome == Repatch)
+            t_slot = &slot;
+        return;
+    }
+    s_overflow.fetch_add(1, std::memory_order_relaxed);
+}
+
+void noteReturn(unsigned line, int resultKind)
+{
+    // Only returns that follow a get_by_id repatch: get_by_val shares tryCacheGetBy.
+    if (!t_slot)
+        return;
+    t_slot->lastLine = line;
+    t_slot = nullptr;
+    s_lines[line % lineCount].fetch_add(1, std::memory_order_relaxed);
+    if (resultKind >= 0)
+        s_results[resultKind % resultCount].fetch_add(1, std::memory_order_relaxed);
+}
+
+namespace {
+
+struct HandlerRecord {
+    std::atomic<uintptr_t> start;
+    unsigned size;
+    char description[56];
+};
+
+constexpr unsigned handlerRecordCount = 4096;
+HandlerRecord s_handlerRecords[handlerRecordCount];
+std::atomic<unsigned> s_nextHandlerRecord;
+
+}
+
+void noteHandler(const void* start, size_t size, const char* description)
+{
+    HandlerRecord& record = s_handlerRecords[s_nextHandlerRecord.fetch_add(1, std::memory_order_relaxed) % handlerRecordCount];
+    record.start.store(0, std::memory_order_relaxed);
+    record.size = static_cast<unsigned>(size);
+    strncpy_s(record.description, sizeof(record.description), description, _TRUNCATE);
+    record.start.store(reinterpret_cast<uintptr_t>(start) & ~static_cast<uintptr_t>(1), std::memory_order_release);
+}
+
+bool describeHandler(uintptr_t pc, char* out, size_t outSize)
+{
+    pc &= ~static_cast<uintptr_t>(1);
+    for (auto& record : s_handlerRecords) {
+        uintptr_t start = record.start.load(std::memory_order_acquire);
+        if (start && pc >= start && pc < start + record.size) {
+            snprintf(out, outSize, "gestore IC %s, +0x%X di %u byte (inizio %08X)", record.description,
+                static_cast<unsigned>(pc - start), record.size, static_cast<unsigned>(start));
+            return true;
+        }
+    }
+    return false;
+}
+
+void start()
+{
+    enabled = false;
+    for (auto& slot : s_slots) {
+        slot.cache.store(nullptr, std::memory_order_relaxed);
+        slot.calls = 0;
+        memset(slot.outcomes, 0, sizeof(slot.outcomes));
+        slot.lastLine = 0;
+        slot.name[0] = 0;
+    }
+    for (auto& count : s_outcomes)
+        count = 0;
+    for (auto& count : s_lines)
+        count = 0;
+    for (auto& count : s_results)
+        count = 0;
+    s_overflow = 0;
+    enabled = true;
+}
+
+void stop()
+{
+    enabled = false;
+}
+
+void dump(void (*log)(const char*))
+{
+    char line[512];
+    unsigned total = 0;
+    for (auto& count : s_outcomes)
+        total += count;
+    snprintf(line, sizeof(line), "cache get_by_id: %u chiamate lente, base non oggetto %u, raffreddamento %u, in attesa %u, tentativi %u, fuori tabella %u",
+        total, s_outcomes[NonCell].load(), s_outcomes[CoolDown].load(), s_outcomes[Buffered].load(), s_outcomes[Repatch].load(), s_overflow.load());
+    log(line);
+
+    // MadeNoChanges, GaveUp, Buffered, GeneratedNewCode, GeneratedFinalCode, GeneratedMegamorphicCode, ResetStub.
+    int length = snprintf(line, sizeof(line), "cache get_by_id: esiti addAccessCase");
+    for (unsigned i = 0; i < 7; ++i)
+        length += snprintf(line + length, sizeof(line) - length, " %u", s_results[i].load());
+    log(line);
+
+    Vector<std::pair<unsigned, unsigned>> returns;
+    for (unsigned i = 0; i < lineCount; ++i) {
+        if (unsigned count = s_lines[i].load())
