+        if (startsWith(tag))
+            return "text/html"_s;
+    }
+    if (startsWith("<?xml"_s))
+        return "text/xml"_s;
+    if (startsWith("%pdf-"_s))
+        return "application/pdf"_s;
+    for (auto byte : data) {
+        if (byte < 0x09 || (byte > 0x0D && byte < 0x20 && byte != 0x1B))
+            return "application/octet-stream"_s;
+    }
+    return "text/plain"_s;
