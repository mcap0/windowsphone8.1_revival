+#include "ICCensus.h"
 
 namespace JSC {
 
+namespace ICCensus {
+
+std::atomic<bool> enabled;
+
+namespace {
+
+constexpr unsigned slotCount = 4096;
+constexpr unsigned lineCount = 4096;
+constexpr unsigned resultCount = 8;
+
+struct Slot {
+    std::atomic<const void*> cache;
+    unsigned calls;
+    unsigned outcomes[OutcomeCount];
+    unsigned lastLine;
+    char name[28];
+};
+
+Slot s_slots[slotCount];
+std::atomic<unsigned> s_outcomes[OutcomeCount];
+std::atomic<unsigned> s_lines[lineCount];
+std::atomic<unsigned> s_results[resultCount];
+std::atomic<unsigned> s_overflow;
+thread_local Slot* t_slot;
+
+struct RefusedCase {
+    char description[56];
+    unsigned count;
+};
+constexpr unsigned refusedCaseCount = 64;
+RefusedCase s_refusedCases[refusedCaseCount];
+Lock s_refusedLock;
+
+}
+
+
+// strncpy_s(..., _TRUNCATE) without the MSVC library (the Linux test build of engine/tools/jsclinux).
+static void copyTruncated(char* destination, size_t size, const char* source)
+{
+    size_t length = strnlen(source, size - 1);
+    memcpy(destination, source, length);
+    destination[length] = 0;
+}
+
+void noteRefusedCase(const char* description)
+{
+    Locker locker { s_refusedLock };
+    for (auto& entry : s_refusedCases) {
+        if (!entry.description[0])
+            copyTruncated(entry.description, sizeof(entry.description), description);
+        if (!strcmp(entry.description, description)) {
+            entry.count++;
+            return;
+        }
+    }
+}
+
+void noteGetById(const void* cache, UniquedStringImpl* name, Outcome outcome)
+{
+    s_outcomes[outcome].fetch_add(1, std::memory_order_relaxed);
+    t_slot = nullptr;
+    unsigned hash = static_cast<unsigned>(reinterpret_cast<uintptr_t>(cache) >> 2) * 2654435761u;
+    for (unsigned probe = 0; probe < 64; ++probe) {
+        Slot& slot = s_slots[(hash + probe) & (slotCount - 1)];
+        const void* current = slot.cache.load(std::memory_order_relaxed);
+        if (!current && slot.cache.compare_exchange_strong(current, cache)) {
+            CString utf8 = name ? String(name).utf8() : CString("?");
+            copyTruncated(slot.name, sizeof(slot.name), utf8.data());
+            current = cache;
+        }
+        if (current != cache)
+            continue;
+        slot.calls++;
+        slot.outcomes[outcome]++;
+        if (outcome == Repatch)
+            t_slot = &slot;
+        return;
+    }
+    s_overflow.fetch_add(1, std::memory_order_relaxed);
+}
+
+void noteReturn(unsigned line, int resultKind)
+{
+    // Only returns that follow a get_by_id repatch: get_by_val shares tryCacheGetBy.
+    if (!t_slot)
+        return;
+    t_slot->lastLine = line;
+    t_slot = nullptr;
