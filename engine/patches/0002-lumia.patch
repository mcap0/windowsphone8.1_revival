+    Locker tilesLocker { AdoptLock, m_tilesLock };
+
+    if (!m_fullLayerRecording)
+        return false;
+    if (m_recordedLayerSize != unscaledSize || m_recordedScale != contentsScale || m_recordedOpaque != m_contentsOpaque)
+        return false;
+
+    Damage damage(IntSize(unscaledSize), Damage::Mode::Rectangles);
+    Vector<uint32_t> tilesToCreate;
+    Vector<uint32_t> tilesToRemove;
+    createOrDestroyTiles(unscaledVisibleRect, IntRect { { }, IntSize(unscaledSize) }, unscaledVisibleRect.size(), contentsScale, m_coverAreaMultiplier, maxTextureSize, damage, tilesToCreate, tilesToRemove);
+
+    Vector<Update::TileUpdate> tilesToUpdate;
+    bool leftUnpainted = false;
+    auto& paintingEngine = layer.client().paintingEngine();
+    for (auto& tile : m_tiles.values()) {
+        if (!tile.isDirty() || tile.waitsForWebThread)
+            continue;
+        // Only what the picture contains: a tile reaching outside it stays dirty for the Web thread, which paints
+        // every dirty tile at its next update (see m_hasUnpaintedTilesFromCompositor).
+        if (!m_recordedRect.contains(tile.dirtyRect)) {
+            leftUnpainted = true;
+            continue;
+        }
+
+        auto buffer = paintingEngine.replay(layer, Ref { *m_fullLayerRecording }, tile.rect, tile.dirtyRect);
+        IntRect updateRect(tile.dirtyRect);
+        updateRect.move(-tile.rect.x(), -tile.rect.y());
+        tilesToUpdate.append({ tile.id, tile.rect, WTF::move(updateRect), WTF::move(buffer) });
+        tile.markClean();
+        // The picture may be older than the contents (a page that changes every frame, then blocks in a script, is
+        // always one picture behind): slightly stale contents beat a black tile. Where they changed since, the tile
+        // stays dirty and the Web thread repaints it at its next update. Refusing such pictures outright is what
+        // left the screen black while scrolling a busy page.
+        IntRect stale = intersection(tile.rect, m_changedSinceRecording);
+        if (!stale.isEmpty()) {
+            tile.addDirtyRect(stale);
+            tile.waitsForWebThread = true;
+            leftUnpainted = true;
+        }
+    }
+    if (leftUnpainted || m_pendingTileCreation)
+        m_hasUnpaintedTilesFromCompositor.store(true, std::memory_order_relaxed);
+
+    if (tilesToCreate.isEmpty() && tilesToUpdate.isEmpty() && tilesToRemove.isEmpty())
+        return false;
+
+    // Rate-limited so a long block cannot flood the log from the compositor thread.
+    static std::atomic<uint64_t> lastLogTime { 0 };
+    uint64_t now = currentTimeInMicroseconds();
+    uint64_t previous = lastLogTime.load(std::memory_order_relaxed);
+    if (now - previous > 500'000 && lastLogTime.compare_exchange_strong(previous, now, std::memory_order_relaxed))
+        WTFLogAlways("tile: compositor, area %dx%d+%d+%d, %u nuovi, %u ridipinti, %u rimossi%s",
+            unscaledVisibleRect.width(), unscaledVisibleRect.height(), unscaledVisibleRect.x(), unscaledVisibleRect.y(),
+            unsigned(tilesToCreate.size()), unsigned(tilesToUpdate.size()), unsigned(tilesToRemove.size()),
+            leftUnpainted ? ", fuori dalla picture lasciati al thread Web" : "");
+
+    Locker updateLocker { m_update.lock };
+    m_update.pending.appendUpdate(WTF::move(tilesToCreate), WTF::move(tilesToUpdate), WTF::move(tilesToRemove));
+    return true;
+}
+#else
+bool CoordinatedBackingStoreProxy::createTilesForAsyncScroll(CoordinatedPlatformLayer&, const IntRect&, const FloatSize&, float, int)
+{
+    return false;
+}
+#endif
