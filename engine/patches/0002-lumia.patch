+void CoordinatedBackingStoreProxy::maybeScheduleFullLayerRecording(CoordinatedPlatformLayer& layer, const IntRect& unscaledVisibleRect, const FloatSize& unscaledSize, float contentsScale, bool contentsOpaque)
+{
+    assertIsMainThread();
+
+#if !USE(SKIA)
+    UNUSED_PARAM(layer);
+    UNUSED_PARAM(unscaledVisibleRect);
+    UNUSED_PARAM(unscaledSize);
+    UNUSED_PARAM(contentsScale);
+    UNUSED_PARAM(contentsOpaque);
+#else
+    m_visibleRectForRecording = unscaledVisibleRect;
+    bool needsRecording;
+    {
+        Locker tilesLocker { m_tilesLock };
+        // A layer whose tiles already cover all of it (buttons, headers, any layer smaller than the cover area) can
+        // never need a tile from the compositor: no picture, no cost.
+        if (m_contentsRect.isEmpty() || unscaledVisibleRect.isEmpty() || m_coverRect.contains(m_contentsRect)) {
+            m_fullLayerRecording = nullptr;
+            return;
+        }
+        // Re-record when the viewport gets within one viewport of the picture's edge (or the contents changed).
+        IntRect visibleRect = mapFromContents(unscaledVisibleRect);
+        IntRect needed = visibleRect;
+        needed.inflateX(visibleRect.width());
+        needed.inflateY(visibleRect.height());
+        needed.intersect(m_contentsRect);
+        needsRecording = !m_fullLayerRecording
+            || m_recordedLayerSize != unscaledSize
+            || m_recordedScale != contentsScale
+            || m_recordedOpaque != contentsOpaque
+            || m_recordedGeneration != m_contentGeneration.load(std::memory_order_relaxed)
+            || !m_recordedRect.contains(needed);
+    }
+    if (!needsRecording)
+        return;
+
+    if (m_recordingScheduled.exchange(true, std::memory_order_acq_rel))
+        return;
+
+    // The task records whatever is current when it runs, which is always consistent because both it and the content
+    // changes live on the Web thread.
+    RunLoop::mainSingleton().dispatchAfter(m_recordingDelay, [protectedThis = Ref { *this }, weakLayer = ThreadSafeWeakPtr { layer }] {
+        protectedThis->m_recordingScheduled.store(false, std::memory_order_release);
+        if (RefPtr layer = weakLayer.get())
+            protectedThis->recordFullLayer(*layer);
+    });
+#endif
+}
+
+#if USE(SKIA)
+void CoordinatedBackingStoreProxy::recordFullLayer(CoordinatedPlatformLayer& layer)
+{
+    assertIsMainThread();
+
+    RefPtr owner = layer.owner();
+    if (!owner)
+        return;
+
+    FloatSize unscaledSize;
+    float contentsScale;
+    bool contentsOpaque;
+    {
+        Locker locker { layer.lock() };
+        unscaledSize = layer.size();
+        contentsScale = layer.contentsScale();
+        contentsOpaque = layer.contentsOpaque();
+    }
+    if (unscaledSize.isEmpty() || contentsScale <= 0 || m_visibleRectForRecording.isEmpty())
+        return;
+
+    // The whole layer whenever it fits: while the Web thread is stuck in a script it cannot record again, so the picture
+    // is all the compositor has, and a fling goes far. A picture of the viewport +-4 screens (tried 2026-10-27) left
+    // the screen black as soon as the finger went past it on a busy page; the whole 768x27698 px scroll-busy layer
+    // records in a few ms on the phone. Only a layer over the limits (32768 px, 64 Mpx) gets a band as tall as the
+    // limits allow, centred on the viewport, re-recorded when the viewport nears its edge.
+    IntRect layerRect(IntPoint::zero(), expandedIntSize(unscaledSize * contentsScale));
+    FloatRect scaledVisibleRect(m_visibleRectForRecording);
+    scaledVisibleRect.scale(contentsScale);
+    IntRect visibleRect = enclosingIntRect(scaledVisibleRect);
+    visibleRect.intersect(layerRect);
+    if (visibleRect.isEmpty())
+        return;
+    static constexpr int maxDimension = 32768;
+    static constexpr uint64_t maxPixels = 64ull * 1024 * 1024;
+    IntRect recordRect = layerRect;
+    if (recordRect.width() > maxDimension) {
+        recordRect.setX(std::max(layerRect.x(), visibleRect.center().x() - maxDimension / 2));
+        recordRect.setWidth(std::min(maxDimension, layerRect.maxX() - recordRect.x()));
+    }
+    int maxHeight = std::min<int>(maxDimension, static_cast<int>(maxPixels / recordRect.width()));
+    if (recordRect.height() > maxHeight) {
+        recordRect.setY(std::max(layerRect.y(), std::min(visibleRect.center().y() - maxHeight / 2, layerRect.maxY() - maxHeight)));
+        recordRect.setHeight(maxHeight);
+    }
+
+    uint64_t generation = m_contentGeneration.load(std::memory_order_relaxed);
+    auto& paintingEngine = layer.client().paintingEngine();
+    // Two tiles' worth of dirty area: force the RTree so partial replays only walk the operations they need.
+    auto start = MonotonicTime::now();
+    Ref recording = paintingEngine.record(*owner, recordRect, contentsOpaque, contentsScale, 2);
+    auto end = MonotonicTime::now();
+
+    // Throttle. Contents that change again soon after a picture (animations, a streaming answer) double the delay up
+    // to 2 s; a picture never takes more than ~10% of the Web thread; a quiet page goes back to 100 ms.
+    bool contentsChanged = generation != m_recordedGeneration;
+    if (contentsChanged && m_lastRecordingTime && end - m_lastRecordingTime < m_recordingDelay * 4)
+        m_recordingDelay = std::min(m_recordingDelay * 2, 2_s);
+    else if (contentsChanged)
+        m_recordingDelay = 100_ms;
+    m_recordingDelay = std::min(std::max(m_recordingDelay, (end - start) * 10), 2_s);
+    m_lastRecordingTime = end;
+
+    WTFLogAlways("tile: picture del layer %dx%d px (scala %.2f, da y %d di %d), registrata in %.1f ms, prossima dopo %.0f ms",
+        recordRect.width(), recordRect.height(), contentsScale, recordRect.y(), layerRect.height(), (end - start).milliseconds(),
+        m_recordingDelay.milliseconds());
+
+    Locker tilesLocker { m_tilesLock };
+    m_fullLayerRecording = WTF::move(recording);
+    m_recordedLayerSize = unscaledSize;
+    m_recordedScale = contentsScale;
+    m_recordedOpaque = contentsOpaque;
+    m_recordedGeneration = generation;
+    m_recordedRect = recordRect;
+    // Recorded from the current contents (changes and recording both happen on this thread): nothing is stale, and
+    // tiles painted from the previous picture can be replayed again from this one.
+    m_changedSinceRecording = { };
+    for (auto& tile : m_tiles.values())
+        tile.waitsForWebThread = false;
+}
+#endif
