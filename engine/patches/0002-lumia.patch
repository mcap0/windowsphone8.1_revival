+    // Heaviest first, so the label that explains the task is the first one read. Insertion sort over at most seven
+    // entries, only when a long task is reported.
+    static void sortDescending(double (&ms)[count], unsigned (&order)[count], unsigned& used)
+    {
+        used = 0;
+        for (unsigned i = 0; i < count; ++i) {
+            if (ms[i] <= 0)
+                continue;
+            unsigned at = used;
+            while (at > 0 && ms[order[at - 1]] < ms[i]) {
+                order[at] = order[at - 1];
+                --at;
+            }
+            order[at] = i;
+            ++used;
+        }
+    }
+
+    static void reportLongTask(State& state, double total)
+    {
+        unsigned order[count] { };
+        unsigned used = 0;
+        sortDescending(state.taskMs, order, used);
+
+        char line[320];
+        int written = snprintf(line, sizeof line, "attivita': [%s] task %.1f ms (coda %u/%u/%u)",
+            state.tag, total, state.pendingInput, state.pendingNormal, state.pendingLow);
+        for (unsigned i = 0; i < used && i < 5 && written > 0 && written < static_cast<int>(sizeof line) - 32; ++i) {
+            unsigned at = order[i];
+            written += snprintf(line + written, sizeof line - written, " %s %.1f",
+                name(static_cast<Activity>(at)), state.taskMs[at]);
+        }
+        emit(line);
+    }
+
+    static void reportSummary(State& state, MonotonicTime now)
+    {
+        double window = (now - state.windowStart).milliseconds();
+        char line[400];
+        int written = snprintf(line, sizeof line, "attivita': [%s] occupato %.1f/%.0f ms (%.0f%%), task %u, lunghi %u",
+            state.tag, state.windowBusyMs, window, window > 0 ? 100.0 * state.windowBusyMs / window : 0.0,
+            state.windowTasks, state.windowLongTasks);
+        for (unsigned i = 0; i < count && written > 0 && written < static_cast<int>(sizeof line) - 24; ++i) {
+            if (state.windowMs[i] <= 0)
+                continue;
+            written += snprintf(line + written, sizeof line - written, " %s %.0f",
+                name(static_cast<Activity>(i)), state.windowMs[i]);
+        }
+        emit(line);
+
+        state.windowStart = now;
+        state.windowBusyMs = 0;
+        for (double& ms : state.windowMs)
+            ms = 0;
+        state.windowTasks = 0;
+        state.windowLongTasks = 0;
+        state.longTaskLines = 0;
+    }
+
+    static void emit(const char* line)
+    {
+        if (auto observer = s_observer.load(std::memory_order_relaxed))
+            observer(line);
+    }
+
+    static inline std::atomic<Observer> s_observer { nullptr };
+    // Only the measured thread writes it (enabled() needs its tag).
+    static inline std::atomic<double> s_taskStart { 0 };
+};
