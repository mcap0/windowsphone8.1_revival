+// Lumia port: a census of the get_by_id inline cache slow path, taken while the profiler runs (port/Profiler.cpp).
+// It answers why operationGetByIdOptimize keeps being called: base not a cell, cool-down after too many repatches,
+// buffering, or a repatch attempt, and for those which return of tryCacheGetBy was taken. Off: one relaxed load.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace WTF {
+class UniquedStringImpl;
+}
+
+namespace JSC::ICCensus {
+
+enum Outcome : uint8_t { NonCell, CoolDown, Buffered, Repatch, OutcomeCount };
+
+extern std::atomic<bool> enabled;
+
+// operationGetByIdOptimize, once per call, before any repatch.
+void noteGetById(const void* cache, WTF::UniquedStringImpl* name, Outcome);
+// tryCacheGetBy after noteGetById: the source line of the return taken and the result of addAccessCase (-1: none).
+void noteReturn(unsigned line, int resultKind);
+
+// Every handler IC stub compiled (address range and what it handles), kept in a ring of the last 4096, and the one
+// containing `pc`: the engine's crash handler names the faulting handler with it.
+void noteHandler(const void* start, size_t size, const char* description);
+bool describeHandler(uintptr_t pc, char* out, size_t outSize);
+
+void start();
+void stop();
+void dump(void (*log)(const char*));
+
+} // namespace JSC::ICCensus
