+/*
+ * The Lumia port's HTTP disk cache, in front of curl (ResourceHandleCurl.cpp, WP81). WebKitLegacy has no network
+ * process, so no NetworkCache: the port implements this interface (port/DiskCache.cpp, on WebKit2's network cache
+ * storage) and sets it at start-up. Main thread.
+ */
+
+#pragma once
+
+#if USE(CURL) && defined(WP81)
+
+#include "ResourceResponse.h"
+#include "SharedBuffer.h"
+#include <wtf/CompletionHandler.h>
+
+namespace WebCore {
+
+class ResourceRequest;
+
+struct ResourceHandleDiskCacheEntry {
+    ResourceResponse response;
+    Ref<FragmentedSharedBuffer> body;
+    // Stale: usable only once the server confirms it (304) to a request carrying its validators.
+    bool needsValidation { false };
+};
+
+class ResourceHandleDiskCache {
+public:
+    virtual ~ResourceHandleDiskCache() = default;
+
+    // A load that may be answered from the disk (a GET whose cache policy allows it).
+    virtual bool canRetrieve(const ResourceRequest&) = 0;
+    // The usable entry for the request, or null. A hit never completes synchronously.
+    virtual void retrieve(const ResourceRequest&, CompletionHandler<void(std::unique_ptr<ResourceHandleDiskCacheEntry>&&)>&&) = 0;
+    // A response worth keeping, by HTTP's rules (no-store, status, expiry or validators, not streaming media).
+    virtual bool canStore(const ResourceRequest&, const ResourceResponse&) = 0;
+    virtual void store(const ResourceRequest&, const ResourceResponse&, Ref<FragmentedSharedBuffer>&&) = 0;
+};
+
+WEBCORE_EXPORT void setResourceHandleDiskCache(ResourceHandleDiskCache*);
+
+} // namespace WebCore
+
+#endif
