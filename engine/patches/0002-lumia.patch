+// It answers why operationGetByIdOptimize keeps being called: base not a cell, cool-down after too many repatches,
+// buffering, or a repatch attempt, and for those which return of tryCacheGetBy was taken. Off: one relaxed load.
+#pragma once
+
+#include <atomic>
+#include <cstddef>
+#include <cstdint>
+
+namespace WTF {
+class UniquedStringImpl;
+}
+
+namespace JSC::ICCensus {
