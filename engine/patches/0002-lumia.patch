+void CoordinatedBackingStoreProxy::maybeScheduleFullLayerRecording(CoordinatedPlatformLayer& layer, const IntRect& unscaledVisibleRect, const FloatSize& unscaledSize, float contentsScale, bool contentsOpaque)
+{
+    assertIsMainThread();
+
+#if !USE(SKIA)
+    UNUSED_PARAM(layer);
+    UNUSED_PARAM(unscaledVisibleRect);
+    UNUSED_PARAM(unscaledSize);
+    UNUSED_PARAM(contentsScale);
+    UNUSED_PARAM(contentsOpaque);
+#else
+    m_visibleRectForRecording = unscaledVisibleRect;
+    bool needsRecording;
+    {
+        Locker tilesLocker { m_tilesLock };
+        // A layer whose tiles already cover all of it (buttons, headers, any layer smaller than the cover area) can
+        // never need a tile from the compositor: no picture, no cost.
+        if (m_contentsRect.isEmpty() || unscaledVisibleRect.isEmpty() || m_coverRect.contains(m_contentsRect)) {
+            m_fullLayerRecording = nullptr;
+            return;
+        }
+        // Re-record when the viewport gets within one viewport of the picture's edge (or the contents changed).
+        IntRect visibleRect = mapFromContents(unscaledVisibleRect);
+        IntRect needed = visibleRect;
+        needed.inflateX(visibleRect.width());
+        needed.inflateY(visibleRect.height());
+        needed.intersect(m_contentsRect);
+        needsRecording = !m_fullLayerRecording
+            || m_recordedLayerSize != unscaledSize
+            || m_recordedScale != contentsScale
+            || m_recordedOpaque != contentsOpaque
+            || m_recordedGeneration != m_contentGeneration.load(std::memory_order_relaxed)
+            || !m_recordedRect.contains(needed);
+    }
+    if (!needsRecording)
+        return;
+
+    if (m_recordingScheduled.exchange(true, std::memory_order_acq_rel))
+        return;
+
+    // The task records whatever is current when it runs, which is always consistent because both it and the content
+    // changes live on the Web thread.
+    RunLoop::mainSingleton().dispatchAfter(m_recordingDelay, [protectedThis = Ref { *this }, weakLayer = ThreadSafeWeakPtr { layer }] {
+        protectedThis->m_recordingScheduled.store(false, std::memory_order_release);
+        if (RefPtr layer = weakLayer.get())
+            protectedThis->recordFullLayer(*layer);
+    });
+#endif
+}
