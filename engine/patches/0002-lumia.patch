+    handle.didReceiveResponse(WTF::move(response), [handle = Ref { handle }, request = Ref { request }] {
+        auto& d = *handle->d;
+        d.m_holdingBody = false;
+        auto held = std::exchange(d.m_heldBody, { });
+        auto completion = std::exchange(d.m_heldCompletion, std::nullopt);
+        if (d.m_cancelled || d.m_curlRequest != request.ptr())
