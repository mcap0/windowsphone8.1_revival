         return;
 
     if (arguments->argumentCount()) {
+#if defined(WP81)
+        StringBuilder allArguments;
+        allArguments.append(messageText);
+        for (size_t i = 1; i < arguments->argumentCount(); ++i) {
+            JSC::JSValue value = arguments->argumentAt(i);
+            allArguments.append(' ');
+            if (value.isString() || value.isNumber() || value.isBoolean() || value.isUndefinedOrNull())
+                allArguments.append(value.toWTFString(lexicalGlobalObject));
+            else if (auto* error = value.isCell() ? dynamicDowncast<JSC::ErrorInstance>(value.asCell()) : nullptr)
+                allArguments.append(error->sanitizedToString(lexicalGlobalObject));
+            else if (value.isObject())
+                allArguments.append("[object "_s, asObject(value)->classInfo()->className, ']');
+            else
+                allArguments.append("[value]"_s);
+        }
+        page->chrome().client().addMessageToConsole(MessageSource::ConsoleAPI, level, allArguments.toString(), lineNumber, columnNumber, url);
+#else
         page->chrome().client().addMessageToConsole(MessageSource::ConsoleAPI, level, messageText, lineNumber, columnNumber, url);
+#endif
 
         if (RefPtr consoleMessageListener = page->consoleMessageListenerForTesting())
