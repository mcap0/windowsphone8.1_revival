+bool TextureMapper::isOutside(const std::optional<FloatRect>& cullRect, const TransformationMatrix& transform, const FloatRect& rect)
+{
+    if (!cullRect || !transform.isAffine())
+        return false;
+    auto bounds = transform.mapRect(rect);
+    bounds.inflate(1);
+    return !bounds.intersects(*cullRect);
