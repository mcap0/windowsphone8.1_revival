+DecodableNnetSimpleLoopedInfo::DecodableNnetSimpleLoopedInfo(
+    const NnetSimpleLoopedComputationOptions &opts,
+    AmNnetSimple *am_nnet, std::istream &is, bool binary):
+    opts(opts), nnet(am_nnet->GetNnet()), log_priors(am_nnet->Priors()) {
+  if (log_priors.Dim() != 0)
+    log_priors.ApplyLog();
+  ExpectToken(is, binary, "<LoopedInfo>");
+  ReadBasicType(is, binary, &frames_left_context);
+  ReadBasicType(is, binary, &frames_right_context);
+  ReadBasicType(is, binary, &frames_per_chunk);
+  ReadBasicType(is, binary, &output_dim);
+  ReadBasicType(is, binary, &has_ivectors);
+  request1.Read(is, binary);
+  request2.Read(is, binary);
+  request3.Read(is, binary);
+  computation.Read(is, binary);  // also computes the CUDA indexes, as Init() does
+  ExpectToken(is, binary, "</LoopedInfo>");
+}
+
+void DecodableNnetSimpleLoopedInfo::WritePrepared(std::ostream &os, bool binary) const {
+  WriteToken(os, binary, "<LoopedInfo>");
+  WriteBasicType(os, binary, frames_left_context);
+  WriteBasicType(os, binary, frames_right_context);
+  WriteBasicType(os, binary, frames_per_chunk);
+  WriteBasicType(os, binary, output_dim);
+  WriteBasicType(os, binary, has_ivectors);
+  request1.Write(os, binary);
+  request2.Write(os, binary);
+  request3.Write(os, binary);
+  computation.Write(os, binary);
+  WriteToken(os, binary, "</LoopedInfo>");
+}
