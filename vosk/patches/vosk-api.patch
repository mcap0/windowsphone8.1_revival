+void Model::WritePrepared(const std::string &path) const
+{
+    struct stat mdl_stat;
+    if (stat(nnet3_rxfilename_.c_str(), &mdl_stat) != 0)  // not inside KALDI_ASSERT: compiled out with NDEBUG
+        KALDI_ERR << "Can't stat " << nnet3_rxfilename_;
+    kaldi::Output ko(path, true);
+    std::ostream &os = ko.Stream();
+    WriteToken(os, true, "<VoskPrep>");
+    WriteBasicType(os, true, static_cast<int32>(2));
+    WriteBasicType(os, true, static_cast<int64>(mdl_stat.st_size));
+    WriteBasicType(os, true, static_cast<int32>(decodable_opts_.frames_per_chunk));
+    WriteBasicType(os, true, static_cast<int32>(decodable_opts_.frame_subsampling_factor));
+    WriteBasicType(os, true, static_cast<int32>(decodable_opts_.extra_left_context_initial));
