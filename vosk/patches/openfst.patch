+#ifdef _WIN32
+// Windows Phone 8.1: CreateFileMappingW failed with error 8 on the 347 MB HCLG and the graph was read
+// instead (PLAN.md §59.6). Map the whole file once (maximum size 0: no size the section must grow to),
+// align views to the allocation granularity (64 KB, not the page size), and fall back to the
+// *FromApp variants that store apps are meant to use. Every failure is logged with its error code.
+namespace {
+using CreateFromAppFn = HANDLE(WINAPI *)(HANDLE, PSECURITY_ATTRIBUTES, ULONG, ULONG64, PCWSTR);
+using MapFromAppFn = PVOID(WINAPI *)(HANDLE, ULONG, ULONG64, SIZE_T);
+FARPROC KernelBaseProc(const char *name) {
+  HMODULE kb = GetModuleHandleW(L"kernelbase.dll");
+  return kb ? GetProcAddress(kb, name) : nullptr;
+}
+}  // namespace
+#endif  // _WIN32
+
