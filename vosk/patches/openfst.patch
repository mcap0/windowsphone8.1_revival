-    LOG(ERROR) << "Can't create mapping for fd=" << fd << " size=" << upsize
-               << ": " << GetLastError();
-    return nullptr;
+  HANDLE file_mapping = CreateFileMappingW(file, nullptr, PAGE_READONLY, 0, 0, nullptr);
+  if (file_mapping == nullptr) {
+    const DWORD err = GetLastError();
+    auto from_app = reinterpret_cast<CreateFromAppFn>(KernelBaseProc("CreateFileMappingFromApp"));
+    file_mapping = from_app ? from_app(file, nullptr, PAGE_READONLY, 0, nullptr) : nullptr;
+    LOG(ERROR) << "CreateFileMappingW failed: " << err << "; CreateFileMappingFromApp "
+               << (from_app ? (file_mapping ? "ok" : "failed: " + std::to_string(GetLastError()))
+                            : std::string("missing"));
+    if (file_mapping == nullptr) {
