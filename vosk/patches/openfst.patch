-               << " offset=" << offset_pos << ": " << GetLastError();
-    CloseHandle(file_mapping);
-    return nullptr;
+    const DWORD err = GetLastError();
+    auto from_app = reinterpret_cast<MapFromAppFn>(KernelBaseProc("MapViewOfFileFromApp"));
+    map = from_app ? from_app(file_mapping, FILE_MAP_READ, offset_pos, upsize) : nullptr;
+    LOG(ERROR) << "MapViewOfFile size=" << upsize << " offset=" << offset_pos << " failed: " << err
+               << "; MapViewOfFileFromApp "
+               << (from_app ? (map ? "ok" : "failed: " + std::to_string(GetLastError()))
+                            : std::string("missing"));
+    if (!map) {
+      CloseHandle(file_mapping);
