+/* WP8.1 (clang-cl, ARM32): not __GNUC__, so the generic fallbacks above are skipped */
+#if !defined(RPCC_DEFINED) && defined(OS_WINDOWS)
+static __inline unsigned long long rpcc(void){
+  LARGE_INTEGER c;
+  QueryPerformanceCounter(&c);
+  return (unsigned long long)c.QuadPart;
+}
+#define RPCC_DEFINED
+#define RPCC64BIT
+#endif
+#if !defined(BLAS_LOCK_DEFINED) && defined(__clang__)
+static __inline void blas_lock(volatile BLASULONG *address){
+  do {
+    while (*address) {YIELDING;};
+  } while (!__sync_bool_compare_and_swap(address, 0, 1));
+}
+#define BLAS_LOCK_DEFINED
+#endif
+
 #ifndef RPCC_DEFINED
 #error "rpcc() implementation is missing for your platform"
 #endif
