#!/usr/bin/env bash
# geminikey — writes apps/Assistente/Assistente/GeminiKey.h from secrets/gemini.key (both git-ignored).
# Run before tools/wp81build Assistente; never print the key.
set -Eeuo pipefail
repo=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
key=$(tr -d '\r\n ' < "$repo/secrets/gemini.key")
umask 077
printf '// Generated by tools/geminikey from secrets/gemini.key: do not share.\n#pragma once\n#define GEMINI_KEY L"%s"\n' "$key" \
    > "$repo/apps/Assistente/Assistente/GeminiKey.h"
echo "GeminiKey.h written (${#key} chars)"
