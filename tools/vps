#!/usr/bin/env bash
# vps script.ps1 — copy a PowerShell script to Windows-Debugger and run it.
set -Eeuo pipefail

if (( $# < 1 )); then
    echo "usage: vps script.ps1 [arguments...]" >&2
    exit 2
fi

script=$1
shift
if [[ ! -f $script ]]; then
    echo "PowerShell script not found: $script" >&2
    exit 2
fi

remote=user@192.168.122.21
vmssh="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)/vmssh"
remote_script="_run_$(date -u +%Y%m%d%H%M%S)_$$.ps1"
cleanup() {
    "$vmssh" ssh "$remote" "del /q C:\\lumia\\$remote_script" >/dev/null 2>&1 || true
}
trap cleanup EXIT

"$vmssh" scp -q "$script" "$remote:C:/lumia/$remote_script"
"$vmssh" ssh "$remote" powershell -NoProfile -ExecutionPolicy Bypass \
    -File "C:\\lumia\\$remote_script" "$@"
