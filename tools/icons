SCALES = (100, 140, 240)
# asset: (width, height at scale 100, glyph size as a fraction of the shorter side, filled background)
ASSETS = {
    "Square150x150Logo": (150, 150, 0.40, False),
    "Square71x71Logo":   (71, 71, 0.50, False),
    "Square44x44Logo":   (44, 44, 0.62, False),
    "StoreLogo":         (50, 50, 0.60, True),
    "SplashScreen":      (480, 800, 0.25, False),
}


def glyph_svg(name):
    if name in CUSTOM:
        return CUSTOM[name]
    for sub in os.listdir(ADW):
        path = os.path.join(ADW, sub, name + "-symbolic.svg")
        if os.path.exists(path):
            text = open(path).read()
            inner = re.search(r"<svg[^>]*>(.*)</svg>", text, re.S).group(1)
            inner = re.sub(r'fill="#[0-9a-fA-F]{3,6}"', 'fill="#ffffff"', inner)
            inner = re.sub(r"fill:#[0-9a-fA-F]{3,6}", "fill:#ffffff", inner)
            return inner
    raise SystemExit("glyph not found: " + name)


def render(glyph, colour, width, height, fraction, filled, out):
    size = min(width, height) * fraction
    scale = size / 16.0
    x, y = (width - size) / 2, (height - size) / 2
    background = '<rect width="%d" height="%d" fill="%s"/>' % (width, height, colour) if filled else ""
    svg = ('<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" viewBox="0 0 %d %d">%s'
           '<g transform="translate(%.3f %.3f) scale(%.5f)">%s</g></svg>'
           % (width, height, width, height, background, x, y, scale, glyph))
    with tempfile.NamedTemporaryFile("w", suffix=".svg", delete=False) as f:
        f.write(svg)
    subprocess.run(["magick", "-background", "none", f.name, "PNG32:" + out], check=True)
    os.unlink(f.name)


# Internet: the icons offered when pinning a page to Start (apps/Browser, TileIcons[] in MainPage.xaml.cpp): the same white
# glyph on a transparent tile, so these follow the phone's accent colour. A site's own icon keeps its own colours.
TILE_ICONS = ["globe", "mail-unread", "chat-message-new", "x-office-calendar", "x-office-document", "document-edit", "folder",
              "image-x-generic", "camera-photo", "video-x-generic", "audio-x-generic", "media-playback-start", "tv",
              "weather-few-clouds", "emoji-travel", "emoji-food", "emoji-nature", "emoji-people", "user-available", "starred",
              "channel-secure", "dialog-password", "phone", "printer", "network-wireless", "system-search",
              "applications-games", "applications-science", "utilities-terminal"]


def tile_icons():
    folder = os.path.join(ROOT, "apps/Browser/Browser/Assets/TileIcons")
    os.makedirs(folder, exist_ok=True)
    for name in TILE_ICONS:
        render(glyph_svg(name), "#000000", 360, 360, 0.40, False, os.path.join(folder, name + ".png"))
    print(len(TILE_ICONS), "icone in", folder)


def apply(app):
    folder, project, glyph_name, colour = APPS[app]
    folder = os.path.join(ROOT, folder)
    if not os.path.isdir(folder):
        print("%-16s (cartella assente, salto)" % app)
        return
    assets = os.path.join(folder, "Assets")
    glyph = glyph_svg(glyph_name)
    assets_list = dict(ASSETS)
    if app in WIDE:
        assets_list["Wide310x150Logo"] = (310, 150, 0.40, False)
    for name, (w, h, fraction, filled) in assets_list.items():
        if name == "SplashScreen" and app in BLACK_SPLASH:
            continue
        plain = os.path.join(assets, name + ".png")
        if os.path.exists(plain):
            os.remove(plain)  # an unqualified file next to the scale-* ones confuses the resource index
        for scale in SCALES:
            render(glyph, colour, round(w * scale / 100), round(h * scale / 100), fraction, filled,
                   os.path.join(assets, "%s.scale-%d.png" % (name, scale)))
    for old in ("SmallTile.png",):
        if os.path.exists(os.path.join(assets, old)):
            os.remove(os.path.join(assets, old))

    manifest = os.path.join(folder, "Package.appxmanifest")
    text = open(manifest, encoding="utf-8-sig").read()
    # tile and app list follow the phone's accent colour like the system apps; the splash keeps the app colour
    text = re.sub(r'BackgroundColor="[^"]*"', 'BackgroundColor="%s"' % ("#000000" if app in BLACK_SPLASH else colour), text)
    text = re.sub(r'(<m3:VisualElements[^>]*?BackgroundColor=")[^"]*"', r'\1transparent"', text, flags=re.S)
    if "Square71x71Logo" not in text:
        text = re.sub(r"(<m3:VisualElements[^>]*>)", r'\1\n        <m3:DefaultTile Square71x71Logo="Assets\\Square71x71Logo.png" />', text, count=1)
    text = text.replace('ForegroundText="dark"', 'ForegroundText="light"')
    open(manifest, "w", encoding="utf-8").write(text)

    proj = os.path.join(folder, project)
    text = open(proj, encoding="utf-8-sig").read()
    if project.endswith(".vcxproj"):
        lines = [l for l in text.split("\n")
                 if not re.search(r'<Image Include="Assets\\(SplashScreen|Square\w+Logo|StoreLogo|SmallTile)\.png"', l)]
        text = "\n".join(lines)
        if 'Image Include="Assets\\*.png"' not in text:
            text = text.replace("<ItemGroup>", '<ItemGroup>\n    <Image Include="Assets\\*.png" />', 1)
        open(proj, "w", encoding="utf-8").write(text)
    print("%-16s %s %s" % (app, colour, glyph_name))


def preview(out):
    tiles = []
    tmp = tempfile.mkdtemp()
    for app, (_, _, glyph_name, colour) in APPS.items():
        glyph = glyph_svg(glyph_name)
        big = os.path.join(tmp, app + "-tile.png")
        small = os.path.join(tmp, app + "-list.png")
        render(glyph, colour, 360, 360, 0.40, True, big)
        render(glyph, colour, 106, 106, 0.62, True, small)
        cell = os.path.join(tmp, app + ".png")
        subprocess.run(["magick", "-size", "400x520", "xc:#111111", big, "-geometry", "+20+20", "-composite",
                        small, "-geometry", "+20+400", "-composite", "-fill", "white", "-pointsize", "30",
                        "-annotate", "+140+460", app, cell], check=True)
        tiles.append(cell)
    subprocess.run(["magick", "montage"] + tiles + ["-tile", "5x", "-geometry", "+0+0", "-background", "#111111", out],
                   check=True)
    print(out)


if __name__ == "__main__":
    if len(sys.argv) < 2 or sys.argv[1] not in ("preview", "apply", "tile-icons"):
        print(__doc__); sys.exit(1)
    if sys.argv[1] == "tile-icons":
        tile_icons()
    elif sys.argv[1] == "preview":
        preview(os.environ.get("OUT", "/tmp/icons-preview.png"))
    else:
        for app in (sys.argv[2:] or list(APPS)):
            apply(app)
