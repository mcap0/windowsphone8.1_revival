#!/bin/bash
# perle81native [input.m4a output.m4a] — sync apps/Perle81 to the VM, build the native tests (Win32, v140)
# and run them there. With two arguments the tests also tag a real m4a file (copied back to the scratchpad dir).
cd ~/dumbphone/apps || exit 1
ssh user@192.168.122.21 "if exist C:\\lumia\\src\\Perle81 rmdir /s /q C:\\lumia\\src\\Perle81" >/dev/null 2>&1
tar --exclude=bin --exclude=obj --exclude=packages --exclude=AppPackages -cf - Perle81 | ssh user@192.168.122.21 "tar -xf - -C C:/lumia/src"
SP=$(mktemp -d)
cat > $SP/build.ps1 <<'PS'
$ErrorActionPreference = 'Continue'
Set-Location C:\lumia\src\Perle81\Perle81.Native\Tests
& "C:\Program Files (x86)\MSBuild\14.0\Bin\MSBuild.exe" Perle81.Native.Tests.vcxproj /t:Build /p:Configuration=Release /p:Platform=Win32 /nologo /v:m 2>&1 | Select-Object -Last 30
"EXIT " + $LASTEXITCODE
if (Test-Path .\Release\Perle81.Native.Tests.exe) { .\Release\Perle81.Native.Tests.exe @args } else { Write-Output "no exe" }
PS
~/dumbphone/tools/vps "$SP/build.ps1" "$@"
rm -rf "$SP"
