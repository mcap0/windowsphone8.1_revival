#!/bin/bash
# uwpbuild <relative project dir> <csproj> — sync apps/ to the VM and build Release|ARM with MSBuild
cd ~/dumbphone/apps || exit 1
dir="$1"; proj="$2"
tar --exclude=bin --exclude=obj --exclude=AppPackages -cf - DumbPhone.pfx DumbPhone.cer "$(echo $dir | cut -d/ -f1)" | ssh user@192.168.122.21 "tar -xf - -C C:/lumia/src"
win=$(echo "$dir" | tr / '\\')
ssh user@192.168.122.21 "cd /d C:\\lumia\\src\\$win && \"C:\\BuildTools2019\\MSBuild\\Current\\Bin\\MSBuild.exe\" $proj /restore /m /nologo /v:m /p:Configuration=Release /p:Platform=ARM /p:AppxPackageDir=C:\\lumia\\out\\ /p:UapAppxPackageBuildMode=SideloadOnly" 2>&1 | grep -vE '^\s*$'
