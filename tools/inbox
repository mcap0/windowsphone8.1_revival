def websocket_echo(handler):
    # /ws for share/browser/websocket.html: RFC 6455 echo. Text and binary messages come back as sent (fragments
    # joined), pings get pongs, a close is answered with its code. No extensions: permessage-deflate offers are declined.
    key = handler.headers.get("Sec-WebSocket-Key", "")
    accept = base64.b64encode(hashlib.sha1((key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11").encode()).digest()).decode()
    # The upgrade needs an HTTP/1.1 status line (WebKit refuses "HTTP/1.0 101"); the server's default is 1.0.
    handler.protocol_version = "HTTP/1.1"
    handler.send_response(101, "Switching Protocols")
    handler.send_header("Upgrade", "websocket")
    handler.send_header("Connection", "Upgrade")
    handler.send_header("Sec-WebSocket-Accept", accept)
    handler.end_headers()
    handler.wfile.flush()
    handler.close_connection = True

    def read(n):
        data = b""
        while len(data) < n:
            chunk = handler.rfile.read(n - len(data))
            if not chunk:
                raise EOFError
            data += chunk
        return data

    def send(opcode, payload):
        n = len(payload)
        head = bytes([0x80 | opcode])
        if n < 126:
            head += bytes([n])
        elif n < 65536:
            head += bytes([126]) + struct.pack(">H", n)
        else:
            head += bytes([127]) + struct.pack(">Q", n)
        handler.wfile.write(head + payload)
        handler.wfile.flush()

    message, message_opcode = b"", 1
    try:
        while True:
            first, second = read(2)
            opcode, length = first & 0x0F, second & 0x7F
            if length == 126:
                length = struct.unpack(">H", read(2))[0]
            elif length == 127:
                length = struct.unpack(">Q", read(8))[0]
            mask = read(4) if second & 0x80 else b"\0\0\0\0"
            payload = read(length)
            if payload:
                pad = (mask * (length // 4 + 1))[:length]
                payload = (int.from_bytes(payload, "big") ^ int.from_bytes(pad, "big")).to_bytes(length, "big")
            if opcode == 8:
                send(8, payload[:2])
                break
            if opcode == 9:
                send(10, payload)
                continue
            if opcode == 10:
                continue
            if opcode in (1, 2):
                message, message_opcode = payload, opcode
            else:
                message += payload
            if first & 0x80:
                send(message_opcode, message)
    except (EOFError, ConnectionError, OSError):
        pass

def test_png(size=96):
    # A square with a blue and orange checkerboard, for "salva immagine" on share/browser/files.html.
    import zlib
    rows = b""
    for y in range(size):
        rows += b"\x00" + b"".join(
            (b"\x19\x76\xd2" if ((x // 12) + (y // 12)) % 2 else b"\xff\x98\x00") for x in range(size))
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xffffffff)
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", size, size, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(rows)) + chunk(b"IEND", b""))

