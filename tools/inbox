def test_download(handler, query, body_fields=None):
    # /download?name=&type=&kb=&attach=1&slow=1 for share/browser/files.html: a PDF, a picture, or `kb` KB of text;
    # attach=1 sends Content-Disposition: attachment; slow=1 sends it in 64 KB steps a quarter of a second apart.
    q = dict(urllib.parse.parse_qsl(query))
    if body_fields:
        q.update(body_fields)
    name = q.get("name", "prova.txt")
    kind = q.get("type", "text/plain")
    if kind == "application/pdf":
        data = TEST_PDF
    elif kind == "image/png":
        data = test_png()
    else:
        line = b"Prova di download dal browser del Lumia, riga di testo ripetuta.\n"
        data = (line * (int(q.get("kb", "4")) * 1024 // len(line) + 1))[: int(q.get("kb", "4")) * 1024]
    handler.send_response(200)
    handler.send_header("Content-Type", kind)
    handler.send_header("Content-Length", str(len(data)))
    if q.get("attach"):
        handler.send_header("Content-Disposition", "attachment; filename=\"%s\"" % name)
    handler.end_headers()
    if q.get("slow"):
        import time
        for i in range(0, len(data), 65536):
            handler.wfile.write(data[i:i + 65536]); handler.wfile.flush(); time.sleep(0.25)
    else:
        handler.wfile.write(data)

def test_upload(handler, body):
    # /upload for share/browser/files.html: the multipart form as received, files saved in share/inbox/upload.
    import email.parser, email.policy
    message = email.parser.BytesParser(policy=email.policy.HTTP).parsebytes(
        b"Content-Type: " + handler.headers.get("Content-Type", "").encode() + b"\r\n\r\n" + body)
    rows = []
    folder = os.path.join(ROOT, "upload"); os.makedirs(folder, exist_ok=True)
    for part in message.iter_parts() if message.is_multipart() else []:
        field = part.get_param("name", header="content-disposition") or "?"
        filename = part.get_filename()
        data = part.get_payload(decode=True) or b""
        if filename:
            safe = re.sub(r"[^A-Za-z0-9._ -]", "_", filename)[-80:] or "file"
            with open(os.path.join(folder, safe), "wb") as f:
                f.write(data)
            rows.append("<li><b>%s</b>: file <b>%s</b>, %d byte, tipo <b>%s</b></li>" % (
                html.escape(field), html.escape(filename), len(data), html.escape(part.get_content_type())))
        elif filename == "":
            rows.append("<li><b>%s</b>: nessun file</li>" % html.escape(field))
        else:
            rows.append("<li><b>%s</b> = %s</li>" % (html.escape(field), html.escape(data.decode("utf-8", "replace")[:200])))
    page = ("<!doctype html><meta charset=utf-8><meta name=viewport content='width=device-width'>"
            "<body style='font:18px sans-serif;background:#000;color:#fff'><h2>Arrivato al PC</h2><ul>%s</ul>"
            "<p>%d byte in tutto. Torna indietro per riprovare.</p>" % ("".join(rows) or "<li>niente</li>", len(body)))
    data = page.encode()
    handler.send_response(200)
    handler.send_header("Content-Type", "text/html; charset=utf-8")
    handler.send_header("Content-Length", str(len(data)))
    handler.end_headers(); handler.wfile.write(data)
    print("upload", len(body), "bytes", flush=True)

CACHE_COUNTS = {}

def test_cached(handler, query):
    # /cached?name=&maxage=&etag=1 for share/browser/cache.html: a script that says how many times the server sent it
    # whole; max-age lets the browser keep it, etag=1 makes it answer If-None-Match with 304. /cached-stats: the counts.
    q = dict(urllib.parse.parse_qsl(query))
    name = re.sub(r"[^A-Za-z0-9_]", "", q.get("name", "x")) or "x"
    counts = CACHE_COUNTS.setdefault(name, {"interi": 0, "304": 0})
    etag = '"%s-v1"' % name
    if q.get("etag") and handler.headers.get("If-None-Match") == etag:
        counts["304"] += 1
        handler.send_response(304)
        handler.send_header("ETag", etag)
        handler.send_header("Cache-Control", "max-age=%s" % q.get("maxage", "0"))
        handler.end_headers()
        return
    counts["interi"] += 1
    body = ("window.cacheTest = window.cacheTest || {}; window.cacheTest[%r] = %d;\n" % (name, counts["interi"])).encode()
    body += b"// " + b"x" * 30000 + b"\n"  # above 16 KB: the cache keeps it as a blob file
    handler.send_response(200)
    handler.send_header("Content-Type", "text/javascript")
    handler.send_header("Content-Length", str(len(body)))
    handler.send_header("Cache-Control", "max-age=%s" % q.get("maxage", "600"))
    if q.get("etag"):
        handler.send_header("ETag", etag)
    handler.end_headers(); handler.wfile.write(body)

class Handler(SimpleHTTPRequestHandler):
    extensions_map = dict(SimpleHTTPRequestHandler.extensions_map, **{
        ".m3u8": "application/vnd.apple.mpegurl", ".ts": "video/mp2t", ".mp4": "video/mp4", ".m4a": "audio/mp4",
        ".mp3": "audio/mpeg", ".ogg": "audio/ogg", ".webm": "video/webm", ".wasm": "application/wasm"})

    def end_headers(self):
        # Whole files say they can be asked in ranges too.
        if not any(b"Accept-Ranges" in line for line in getattr(self, "_headers_buffer", [])):
            self.send_header("Accept-Ranges", "bytes")
        super().end_headers()

    def do_GET(self):
        if urllib.parse.urlsplit(self.path).path == "/ws" and self.headers.get("Upgrade", "").lower() == "websocket":
            return websocket_echo(self)
        # Bing field → (SearchServer = this server): bypass Bing's bing://search
        # handoff for the legacy Windows Phone user agent and return actual SERP HTML.
        request = urllib.parse.urlsplit(self.path)
        # What the phone's browsers send, header by header in order (share/inbox/headers.txt), for the test index.
        if request.path in ("/browser/", "/headers"):
            with open(os.path.join(ROOT, "headers.txt"), "a") as f:
                f.write("\n===== %s %s %s =====\n" % (datetime.datetime.now().isoformat(timespec="seconds"), self.request_version, self.path))
                for key, value in self.headers.items():
                    f.write("%s: %s\n" % (key, value))
        if request.path == "/download":
            return test_download(self, request.query)
        if request.path == "/auth":
            # HTTP basic authentication, for the browser's password prompt (share/browser/moduli.html): prova / prova.
            given = self.headers.get("Authorization", "")
            good = given == "Basic " + base64.b64encode(b"prova:prova").decode()
            body = (b"<meta name=viewport content='width=device-width'><body style='background:#000;color:#b9f6ca;font:20px sans-serif'>"
                    b"<p>Password HTTP accettata.</p><p><a style='color:#fff' href='/browser/moduli.html'>indietro</a></p>" if good
                    else b"<body><p>Serve la password (prova / prova).</p>")
            self.send_response(200 if good else 401)
            if not good:
                self.send_header("WWW-Authenticate", 'Basic realm="Prove browser"')
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers(); self.wfile.write(body)
            return
        # A byte range of a file under share/ (media elements ask for ranges, and seek with them): http.server alone
        # always sends the whole file.
        wanted = re.fullmatch(r"bytes=(\d*)-(\d*)", self.headers.get("Range", "").strip())
        if wanted and (wanted.group(1) or wanted.group(2)):
            path = self.translate_path(self.path)
            if os.path.isfile(path):
                size = os.path.getsize(path)
                if wanted.group(1):
                    first = int(wanted.group(1))
                    last = min(int(wanted.group(2)), size - 1) if wanted.group(2) else size - 1
                else:
                    first, last = max(size - int(wanted.group(2)), 0), size - 1
                if first > last or first >= size:
                    self.send_response(416)
                    self.send_header("Content-Range", "bytes */%d" % size)
                    self.send_header("Content-Length", "0")
                    self.end_headers()
                    return
                self.send_response(206)
                self.send_header("Content-Type", self.guess_type(path))
                self.send_header("Accept-Ranges", "bytes")
                self.send_header("Content-Range", "bytes %d-%d/%d" % (first, last, size))
                self.send_header("Content-Length", str(last - first + 1))
                self.end_headers()
                with open(path, "rb") as f:
                    f.seek(first)
                    left = last - first + 1
                    while left > 0:
                        chunk = f.read(min(left, 256 * 1024))
                        if not chunk:
                            break
                        try:
                            self.wfile.write(chunk)
                        except OSError:
                            return
                        left -= len(chunk)
                return
        if request.path == "/cached":
            return test_cached(self, request.query)
        if request.path == "/cached-stats":
            data = json.dumps(CACHE_COUNTS).encode()
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Cache-Control", "no-store")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers(); self.wfile.write(data)
            return
        if request.path == "/beacon":
            # image beacon from MetroSurf's custom script on https sites (XHR to http is blocked there)
            with open(os.path.join(ROOT, "beacon.txt"), "a") as f:
                f.write("%s %s\n" % (datetime.datetime.now().strftime("%H:%M:%S"),
                                      urllib.parse.unquote(request.query)))
            gif = base64.b64decode("R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7")
            self.send_response(200)
            self.send_header("Content-Type", "image/gif")
            self.send_header("Content-Length", str(len(gif)))
            self.end_headers(); self.wfile.write(gif)
            return
        if request.path.startswith("/rp/"):
            try:
                status, content_type, body = fetch_bing_asset(self.path, self.headers.get("Accept-Language", ""))
            except (urllib.error.URLError, TimeoutError, OSError) as exc:
                status, content_type, body = 502, "text/plain; charset=utf-8", str(exc).encode("utf-8")
            with open(os.path.join(ROOT, "search.txt"), "a") as f:
                f.write("\n===== %s =====\nBing asset %s status=%d type=%s bytes=%d\n" %
                        (datetime.datetime.now().isoformat(timespec="seconds"), self.path, status, content_type, len(body)))
            self.send_response(status)
            self.send_header("Content-Type", content_type)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers(); self.wfile.write(body)
            return
        if request.path != "/search":
            return super().do_GET()
        status, content_type, body = 502, "text/html; charset=utf-8", b""
        error = ""
        try:
            status, content_type, body = fetch_bing_results(self.path, self.headers.get("Accept-Language", ""))
        except (urllib.error.URLError, TimeoutError, OSError) as exc:
            error = str(exc)
            body = ("<html><body><p>Impossibile caricare i risultati Bing.</p><p>%s</p></body></html>" %
                    html.escape(error)).encode("utf-8")
        title = re.search(rb"<title[^>]*>(.*?)</title", body, re.I | re.S)
        title = re.sub(rb"\s+", b" ", title.group(1)).decode("utf-8", "replace") if title else ""
        upstream_b_algo = body.count(b"b_algo")
        parsed_results = parse_bing_results(body) if status == 200 else []
        upstream_bytes = len(body)
        if status == 200:
            body = build_legacy_results_page(self.path, parsed_results)
            content_type = "text/html; charset=utf-8"
        with open(os.path.join(ROOT, "search.txt"), "a") as f:
            f.write("\n===== %s =====\n%s\n%s\nUpstream: status=%d type=%s bytes=%d b_algo=%d parsed=%d title=%s error=%s\n" %
                    (datetime.datetime.now().isoformat(timespec="seconds"), self.path, self.headers,
                     status, content_type, upstream_bytes, upstream_b_algo, len(parsed_results), title, error))
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers(); self.wfile.write(body)

    def do_POST(self):
        request = urllib.parse.urlsplit(self.path)
        if request.path in ("/download", "/upload"):
            body = self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 64 << 20))
            if request.path == "/upload":
                return test_upload(self, body)
            return test_download(self, request.query, dict(urllib.parse.parse_qsl(body.decode("utf-8", "replace"))))
        name = re.sub(r"[^A-Za-z0-9_-]", "", self.path.strip("/")) or "log"
        if "chunked" in self.headers.get("Transfer-Encoding", "").lower():
            # big uploads from the phone (HttpClient switches to chunked transfer)
            body = b""
            while True:
                size = int(self.rfile.readline().split(b";")[0].strip() or b"0", 16)
                if size == 0:
                    self.rfile.readline()
                    break
                body += self.rfile.read(size)
                self.rfile.readline()
        else:
            body = self.rfile.read(min(int(self.headers.get("Content-Length", 0)), 64 << 20))
        if body:
            with open(os.path.join(ROOT, name + ".txt"), "ab") as f:
                f.write(("\n===== %s =====\n" % datetime.datetime.now().isoformat(timespec="seconds")).encode())
                f.write(body)
        # Commands for the app that owns this log (tools/phonecmd writes share/inbox/cmd/<name>.txt): they leave in the
        # reply to its next post, once. The apps that don't know about them read "ok" as before.
        reply = b"ok"
        queue = os.path.join(ROOT, "cmd", name + ".txt")
        taken = queue + ".%d" % os.getpid()
        try:
            os.rename(queue, taken)
            with open(taken, "rb") as f:
                reply = b"cmd\n" + f.read()
            os.remove(taken)
        except OSError:
            pass
        self.send_response(200); self.send_header("Content-Length", str(len(reply))); self.end_headers(); self.wfile.write(reply)
        if body:
            print("received", name, len(body), "bytes", flush=True)

if __name__ == "__main__":
    # inbox [bind-address] [port]: a second instance on another port can serve the same share/ (opencode uses 8766).
    in_bind = sys.argv[1] if len(sys.argv) > 1 else "192.168.1.148"
    in_port = int(sys.argv[2]) if len(sys.argv) > 2 else 8765
    server = HTTPServer((in_bind, in_port), functools.partial(Handler, directory=SHARE))
    server.daemon_threads = True
    server.serve_forever()
