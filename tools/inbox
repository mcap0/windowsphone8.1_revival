SHARE = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "share")
ROOT = os.path.join(SHARE, "inbox")
os.makedirs(ROOT, exist_ok=True)

def fetch_bing_results(path, language):
    # Bing sends the Windows Phone user agent to a tiny "Opening Bing…" page
    # whose meta refresh is bing://search. Fetch as a normal browser so this
    # embedded SearchCM browser gets an actual HTML results page instead.
    url = "https://www.bing.com" + path
    request = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/133.0 Safari/537.36",
        "Accept": "text/html,application/xhtml+xml,application/xml;q=0.9,*/*;q=0.8",
        "Accept-Language": language or "en-US,en;q=0.5",
    })
    with urllib.request.urlopen(request, timeout=20) as response:
        return response.status, response.headers.get("Content-Type", "text/html; charset=utf-8"), response.read()

def fetch_bing_asset(path, language):
    # SERP HTML references some Bing scripts through relative /rp/... URLs.
    # Since SearchServer points at this host, pass those assets through too.
    url = "https://www.bing.com" + path
    request = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 Chrome/133.0 Safari/537.36",
        "Accept": "*/*",
        "Accept-Language": language or "en-US,en;q=0.5",
    })
    try:
        with urllib.request.urlopen(request, timeout=20) as response:
            return response.status, response.headers.get("Content-Type", "application/octet-stream"), response.read()
    except urllib.error.HTTPError as response:
        return response.code, response.headers.get("Content-Type", "text/plain; charset=utf-8"), response.read()

def fetch_bing_suggestions(query, language):
    url = "https://api.bing.com/qsonhs.aspx?" + urllib.parse.urlencode({
        "q": query, "form": "MO0014", "mkt": "it-IT",
    })
    request = urllib.request.Request(url, headers={
        "User-Agent": "Mozilla/5.0 (Windows Phone 8.1; ARM; Trident/7.0; Touch; rv:11.0; IEMobile/11.0) like Gecko",
        "Accept": "application/json, text/javascript, */*; q=0.01",
        "Accept-Language": language or "it-IT,it;q=0.9,en-US;q=0.7",
    })
    with urllib.request.urlopen(request, timeout=15) as response:
        return response.status, response.headers.get("Content-Type", "application/json; charset=utf-8"), response.read()

class BingResultParser(HTMLParser):
    """Extract Bing's server-rendered Web results without running its modern page scripts."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.stack = []
        self.results = []
        self.current = None
        self.root_depth = 0

    def handle_starttag(self, tag, attrs):
        attrs = dict(attrs)
        if tag == "li" and self.current is None and "b_algo" in (attrs.get("class") or "").split():
            self.current = {"title": "", "url": "", "snippet": ""}
            self.root_depth = len(self.stack)
        elif self.current is not None and tag == "a" and not self.current["url"]:
            if any(parent == "h2" for parent, _ in self.stack):
                self.current["url"] = attrs.get("href", "")
        self.stack.append((tag, attrs))

    def handle_endtag(self, tag):
        if (self.current is not None and tag == "li" and len(self.stack) == self.root_depth + 1
                and self.stack[-1][0] == "li"):
            self.results.append(self.current)
            self.current = None
        for index in range(len(self.stack) - 1, -1, -1):
            if self.stack[index][0] == tag:
                del self.stack[index:]
                break

    def handle_data(self, data):
        if self.current is None:
            return
        if any(tag == "h2" for tag, _ in self.stack):
            self.current["title"] += data
        elif (any(tag == "p" for tag, _ in self.stack)
                and any("b_caption" in (attrs.get("class") or "").split() for _, attrs in self.stack)):
            self.current["snippet"] += data

def parse_bing_results(body):
    parser = BingResultParser()
    parser.feed(body.decode("utf-8", "replace"))
    results = []
    for item in parser.results:
        title = re.sub(r"\s+", " ", item["title"]).strip()
        snippet = re.sub(r"\s+", " ", item["snippet"]).strip()
        url = item["url"].strip()
        try:
            parsed = urllib.parse.urlsplit(url)
            if parsed.hostname and parsed.hostname.endswith("bing.com") and parsed.path == "/ck/a":
                wrapped = urllib.parse.parse_qs(parsed.query).get("u", [""])[0]
                if wrapped.startswith("a1"):
                    decoded = base64.urlsafe_b64decode(wrapped[2:] + "===").decode("utf-8", "replace")
                    if decoded.startswith(("http://", "https://")):
                        url = decoded
        except (ValueError, UnicodeError):
            pass
        if title and url.startswith(("http://", "https://")):
            results.append((title, url, snippet))
    return results

class BingImageParser(HTMLParser):
    """Read Bing's image-card metadata from its server-rendered result page."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.results = []

    def handle_starttag(self, tag, attrs):
        if tag != "a":
            return
        attrs = dict(attrs)
        if "iusc" not in (attrs.get("class") or "").split():
            return
        try:
            meta = json.loads(attrs.get("m", "{}"))
        except (TypeError, ValueError):
            return
        image = meta.get("murl", "")
        thumb = meta.get("turl", "")
        page = meta.get("purl", attrs.get("href", ""))
        title = meta.get("t", "")
        description = meta.get("desc", "")
        if image.startswith(("http://", "https://")) and thumb.startswith(("http://", "https://")):
            self.results.append({
                "title": re.sub(r"\s+", " ", str(title)).strip(),
                "url": page if str(page).startswith(("http://", "https://")) else image,
                "image": image,
                "thumbnail": thumb,
                "snippet": re.sub(r"\s+", " ", str(description)).strip(),
            })

def parse_bing_images(body):
    parser = BingImageParser()
    parser.feed(body.decode("utf-8", "replace"))
    unique = []
    seen = set()
    for item in parser.results:
        if item["image"] in seen:
            continue
        seen.add(item["image"])
        unique.append(item)
        if len(unique) >= 40:
            break
    return unique

