#!/usr/bin/env bash
# enginetest [install] — stage the engine test binaries (engine/out) into apps/EngineTest, check their imports against
# the phone's DLLs, then build (and optionally install) the "Prova motore" app through the VM with wp81build.
set -Eeuo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
engine=$root/engine
dest=$root/apps/EngineTest/EngineTest/engine
mkdir -p "$dest"
rm -f "$dest"/*
cp "$engine/out/webkit/bin/jsctest.dll" "$dest/"
cp "$engine/out/deps/lib/icudt77l.dat" "$dest/"
python3 -I "$engine/tools/checkimports.py" "$dest"/*.dll --package "$dest"
exec "$root/tools/wp81build" EngineTest EngineTest.sln "$@"
