<Page x:Class="Perle.App.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="VideoArea" Background="Black">
      <MediaPlayerElement x:Name="Player" AreTransportControlsEnabled="True" AutoPlay="True" Stretch="Uniform" />
      <ProgressRing x:Name="Busy" IsActive="True" Width="48" Height="48" />
    </Grid>
    <ScrollViewer Grid.Row="1">
      <StackPanel Margin="12,8">
        <TextBlock x:Name="TitleText" FontSize="18" TextWrapping="Wrap" />
        <TextBlock x:Name="MetaText" FontSize="13" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="DescriptionText" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" IsTextSelectionEnabled="True" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <Page.BottomAppBar>
    <CommandBar x:Name="Commands" ClosedDisplayMode="Compact">
      <AppBarButton x:Name="CastButton" Label="Trasmetti a TV" Click="OnCast" IsEnabled="False">
        <AppBarButton.Icon>
          <FontIcon Glyph="&#xEC15;" />
        </AppBarButton.Icon>
      </AppBarButton>
    </CommandBar>
  </Page.BottomAppBar>
</Page>
