<Page x:Class="Perle.App.CastControllerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <ScrollViewer>
    <StackPanel Margin="12,8">
      <TextBlock Text="Trasmetti a TV" FontSize="24" FontWeight="SemiBold" />
      <TextBlock x:Name="DeviceText" FontSize="13" Opacity="0.7" Margin="0,2,0,12" />
      <TextBlock x:Name="TitleText" FontSize="18" TextWrapping="Wrap" />
      <TextBlock x:Name="UploaderText" FontSize="13" Opacity="0.7" Margin="0,2,0,0" />
      <TextBlock x:Name="StatusText" FontSize="13" Margin="0,8,0,0" />
      <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,4,0,0" />

      <Slider x:Name="SeekBar" Margin="0,8,0,0" IsThumbToolTipEnabled="False" ValueChanged="OnSeekValueChanged" />
      <Grid>
        <TextBlock x:Name="PositionText" FontSize="12" />
        <TextBlock x:Name="DurationText" FontSize="12" HorizontalAlignment="Right" />
      </Grid>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
        <Button x:Name="PlayPauseButton" Click="OnPlayPause" Width="72" Height="56" Margin="6,0">
          <SymbolIcon x:Name="PlayPauseIcon" Symbol="Play" />
        </Button>
        <Button x:Name="StopButton" Click="OnStop" Width="72" Height="56" Margin="6,0">
          <SymbolIcon Symbol="Stop" />
        </Button>
        <Button x:Name="NextButton" Click="OnNext" Width="72" Height="56" Margin="6,0">
          <SymbolIcon Symbol="Next" />
        </Button>
      </StackPanel>

      <StackPanel x:Name="VolumeControls" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
        <Button x:Name="VolumeDownButton" Click="OnVolumeDown" Width="56" Margin="6,0">
          <SymbolIcon Symbol="Volume" />
        </Button>
        <TextBlock x:Name="VolumeText" VerticalAlignment="Center" Width="90" TextAlignment="Center" />
        <Button x:Name="VolumeUpButton" Click="OnVolumeUp" Width="56" Margin="6,0">
          <SymbolIcon Symbol="Add" />
        </Button>
      </StackPanel>

      <Button x:Name="QualityButton" Click="OnQuality" HorizontalAlignment="Stretch" Margin="0,16,0,0" />
      <Button x:Name="AudioTrackButton" Click="OnAudioTrack" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
      <Button x:Name="SubtitlesButton" Click="OnSubtitles" HorizontalAlignment="Stretch" Margin="0,8,0,0" />

      <TextBlock x:Name="QueueTitle" Text="Coda" FontSize="18" Margin="0,20,0,4" />
      <StackPanel x:Name="QueueList" />

      <Button Content="Copia log" Click="OnCopyLog" Margin="0,20,0,12" />
    </StackPanel>
  </ScrollViewer>
</Page>
