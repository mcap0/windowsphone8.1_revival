<Page
    x:Class="Musica.ArtistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF111111"
    Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>
        <Pivot x:Name="ArtistPivot" Grid.Row="0" Title="ARTISTA">
            <PivotItem Header="album">
                <ListView x:Name="ArtistAlbums" IsItemClickEnabled="True" ItemClick="OnAlbumClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,9">
                                <TextBlock Text="{Binding Name}" FontSize="22" />
                                <TextBlock Text="{Binding Summary}" FontSize="15" Foreground="#FFBBBBBB" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
            <PivotItem Header="brani">
                <ListView x:Name="ArtistSongs" IsItemClickEnabled="True" ItemClick="OnSongClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,8">
                                <TextBlock Text="{Binding Title}" FontSize="21" />
                                <TextBlock Text="{Binding Album}" FontSize="15" Foreground="#FFBBBBBB" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </PivotItem>
        </Pivot>
        <Grid Grid.Row="1" Background="#FF242424" Tapped="OnMiniTapped">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="MiniTitle" FontSize="17" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MiniArtist" FontSize="13" Foreground="#FFBBBBBB" />
            </StackPanel>
            <Border Grid.Column="1" Width="64" Height="68" Background="Transparent" Tapped="OnPlayClick">
                <TextBlock x:Name="MiniButton"
                           Text="&#x25B6;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="23"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Page>
