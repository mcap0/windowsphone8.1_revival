<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest"
         xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest"
         xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="DumbPhone.Musica" Publisher="CN=DumbPhone" Version="1.7.10.0" />
  <mp:PhoneIdentity PhoneProductId="eaa38124-37f3-412e-b269-ea79cbe16ca6" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Musica</DisplayName>
    <PublisherDisplayName>DumbPhone</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="it" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Musica.App">
      <m3:VisualElements DisplayName="Musica"
                         Square150x150Logo="Assets\Square150x150Logo.png"
                         Square44x44Logo="Assets\Square44x44Logo.png"
                         Description="Lettore musicale"
                         ForegroundText="light"
                         BackgroundColor="transparent"
                         ToastCapable="false">
        <m3:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
        <m3:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#EF6C00" />
      </m3:VisualElements>
      <Extensions>
        <Extension Category="windows.backgroundTasks" EntryPoint="MusicaAudioTask.AudioTask">
          <BackgroundTasks>
            <Task Type="audio" />
          </BackgroundTasks>
        </Extension>
        <Extension Category="windows.protocol">
          <Protocol Name="musica" />
        </Extension>
        <Extension Category="windows.fileTypeAssociation">
          <FileTypeAssociation Name="audio">
            <DisplayName>Musica</DisplayName>
            <SupportedFileTypes>
              <FileType>.mp3</FileType>
              <FileType>.m4a</FileType>
              <FileType>.wma</FileType>
              <FileType>.wav</FileType>
              <FileType>.aac</FileType>
              <FileType>.flac</FileType>
            </SupportedFileTypes>
          </FileTypeAssociation>
        </Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="musicLibrary" />
  </Capabilities>
</Package>
