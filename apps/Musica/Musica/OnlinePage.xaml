<Page
    x:Class="Musica.OnlinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Pivot x:Name="Tabs" Title="MUSICA">
        <PivotItem Header="online">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="Query" PlaceholderText="brano, artista..." InputScope="Search" KeyUp="Query_KeyUp" />
                <TextBlock x:Name="SearchStatus" Grid.Row="1" FontSize="15" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,6"
                           Text="Tocca un brano: si scarica in pochi secondi e parte. Resta nella libreria (Music\Online)." />
                <ListView x:Name="Results" Grid.Row="2" IsItemClickEnabled="True" ItemClick="Results_ItemClick" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6" Background="Transparent" Holding="Result_Holding">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="20" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="15" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="15" Margin="10,0,0,0"
                                           Foreground="{ThemeResource PhoneAccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </PivotItem>
        <PivotItem Header="spotify">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBox x:Name="SpotifyLink" PlaceholderText="link di una playlist o di un album" InputScope="Url" KeyUp="SpotifyLink_KeyUp" />
                <TextBlock x:Name="SpotifyStatus" Grid.Row="1" FontSize="15" Opacity="0.7" TextWrapping="Wrap" Margin="0,4,0,6"
                           Text="Su Spotify: tre puntini › Condividi › Copia link, poi incollalo qui." />
                <Button x:Name="ImportButton" Grid.Row="2" Content="crea la playlist e scarica" HorizontalAlignment="Stretch"
                        Visibility="Collapsed" Click="Import_Click" />
                <ListView x:Name="Tracks" Grid.Row="3" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontSize="18" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" FontSize="14" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="14" Margin="10,0,0,0"
                                           Foreground="{ThemeResource PhoneAccentBrush}" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </PivotItem>
    </Pivot>
</Page>
