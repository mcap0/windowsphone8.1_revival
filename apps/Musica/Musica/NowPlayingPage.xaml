<Page
    x:Class="Musica.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF111111"
    Foreground="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>
        <ScrollViewer Grid.Row="0">
            <StackPanel Margin="20,12">
                <Image x:Name="NowCover" Width="270" Height="270" HorizontalAlignment="Center" Stretch="UniformToFill" />
                <TextBlock x:Name="NowTitle" FontSize="26" TextAlignment="Center" Margin="0,14,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="NowArtist" FontSize="19" Foreground="#FFBBBBBB" TextAlignment="Center" />
                <TextBlock x:Name="NowAlbum" FontSize="16" Foreground="#FF888888" TextAlignment="Center" />
                <Slider x:Name="PositionSlider"
                        Minimum="0"
                        Maximum="1"
                        ValueChanged="OnPositionChanged"
                        PointerPressed="OnPositionPointerPressed"
                        PointerReleased="OnPositionPointerReleased" />
                <Grid>
                    <TextBlock x:Name="PositionText" HorizontalAlignment="Left" />
                    <TextBlock x:Name="DurationText" HorizontalAlignment="Right" />
                </Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8">
                    <Border Width="64" Height="64" Background="Transparent" Tapped="OnPrevious">
                        <TextBlock Text="&#x23EE;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="27"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Width="64" Height="64" Background="Transparent" Tapped="OnPlayPause">
                        <TextBlock x:Name="PlayButton"
                                   Text="&#x25B6;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="27"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Width="64" Height="64" Background="Transparent" Tapped="OnNext">
                        <TextBlock Text="&#x23ED;"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="27"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Width="120" Height="56" Background="Transparent" Tapped="OnShuffle">
                        <TextBlock x:Name="ShuffleButton"
                                   Text="&#x21C4; casuale: no"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <Border Width="120" Height="56" Background="Transparent" Tapped="OnRepeat">
                        <TextBlock x:Name="RepeatButton"
                                   Text="&#x267B; ripeti: no"
                                   FontFamily="Segoe UI Symbol"
                                   FontSize="16"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
                <TextBlock Text="CODA" FontSize="22" Margin="4,12,0,0" />
                <ListView x:Name="QueueList" IsItemClickEnabled="True" ItemClick="OnQueueClick">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,5">
                                <TextBlock Text="{Binding Title}" FontSize="18" />
                                <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="#FFBBBBBB" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="1" Background="#FF242424" Tapped="OnMiniTapped">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="MiniTitle" FontSize="17" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MiniArtist" FontSize="13" Foreground="#FFBBBBBB" />
            </StackPanel>
            <Border Grid.Column="1"
                    Width="64"
                    Height="68"
                    Background="Transparent"
                    Tapped="OnPlayClick">
                <TextBlock x:Name="MiniButton"
                           Text="&#x25B6;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="23"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Page>
