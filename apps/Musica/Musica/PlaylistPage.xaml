<Page
    x:Class="Musica.PlaylistPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF111111"
    Foreground="White">
    <Page.BottomAppBar>
        <CommandBar>
            <CommandBar.PrimaryCommands>
                <AppBarButton Label="seleziona" Icon="Edit" Click="OnSelect" />
                <AppBarButton Label="rinomina" Icon="Rename" Click="OnRename" />
                <AppBarButton Label="elimina" Icon="Delete" Click="OnDelete" />
            </CommandBar.PrimaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="68" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
                <TextBlock x:Name="PageTitle" Text="PLAYLIST" FontSize="30" Margin="0,5,0,8" />
                <TextBlock x:Name="TrackCount" FontSize="15" Foreground="#FFBBBBBB" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="riproduci" Click="OnPlay" />
                    <Button Content="casuale" Click="OnShuffle" Margin="12,0,0,0" />
                </StackPanel>
            </StackPanel>
            <ListView x:Name="PlaylistTracks"
                      Grid.Row="1"
                      IsItemClickEnabled="True"
                      ItemClick="OnTrackClick"
                      Holding="OnTrackHolding">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,6">
                            <TextBlock Text="{Binding Title}" FontSize="19" />
                            <TextBlock Text="{Binding Artist}" FontSize="14" Foreground="#FFBBBBBB" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
        <Grid Grid.Row="1" Background="#FF242424" Tapped="OnMiniTapped">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="12,0">
                <TextBlock x:Name="MiniTitle" FontSize="17" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="MiniArtist" FontSize="13" Foreground="#FFBBBBBB" />
            </StackPanel>
            <Border Grid.Column="1" Width="64" Height="68" Background="Transparent" Tapped="OnPlayClick">
                <TextBlock x:Name="MiniButton"
                           Text="&#x25B6;"
                           FontFamily="Segoe UI Symbol"
                           FontSize="23"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</Page>
