<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest"
         xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest"
         xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="DumbPhone.Browser" Publisher="CN=DumbPhone" Version="0.1.0.67" />
  <mp:PhoneIdentity PhoneProductId="afcc45ef-005b-42f6-b2bd-18695a1f8826" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Internet</DisplayName>
    <PublisherDisplayName>DumbPhone</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="it" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Browser.App">
      <m3:VisualElements DisplayName="Internet"
                         Square150x150Logo="Assets\Square150x150Logo.png"
                         Square44x44Logo="Assets\Square44x44Logo.png"
                         Description="Browser sul motore WebKit compilato da noi"
                         ForegroundText="light"
                         BackgroundColor="transparent"
                         ToastCapable="true">
        <m3:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
        <m3:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#1976D2" />
      </m3:VisualElements>
      <!-- internet:u/<address>: our other apps (Posta, Cerca, WhatsApp...) open a link here instead of in IE. -->
      <Extensions>
        <Extension Category="windows.protocol">
          <Protocol Name="internet" />
        </Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClient" />
    <Capability Name="privateNetworkClientServer" />
    <DeviceCapability Name="location" />
  </Capabilities>
</Package>
