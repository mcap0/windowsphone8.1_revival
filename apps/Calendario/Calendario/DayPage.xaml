<Page
    x:Class="Calendario.DayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="EventTemplate">
            <Grid Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="{Binding BarBrush}" Margin="0,2,12,2" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding TimeText}" FontSize="15" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Title}" FontSize="20" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="14" Opacity="0.7" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Back" Label="Giorno prima" Click="PreviousDay_Click" />
            <AppBarButton Icon="Forward" Label="Giorno dopo" Click="NextDay_Click" />
            <AppBarButton Icon="Add" Label="Aggiungi" Click="Add_Click" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="DayTitleText" FontSize="26" TextWrapping="Wrap" Margin="0,8,0,12" />
        <TextBlock x:Name="StatusText" Grid.Row="1" FontSize="14" Opacity="0.7" TextWrapping="Wrap" />
        <ListView x:Name="EventList" Grid.Row="2" SelectionMode="None" IsItemClickEnabled="True"
                  ItemTemplate="{StaticResource EventTemplate}" ItemClick="EventList_ItemClick" />
    </Grid>
</Page>
