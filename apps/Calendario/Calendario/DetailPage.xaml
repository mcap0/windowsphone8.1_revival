<Page
    x:Class="Calendario.DetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="EditButton" Icon="Edit" Label="Modifica" Click="Edit_Click" Visibility="Collapsed" />
            <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Elimina" Click="Delete_Click" Visibility="Collapsed" />
        </CommandBar>
    </Page.BottomAppBar>

    <ScrollViewer>
        <StackPanel Margin="16,12,16,24">
            <TextBlock x:Name="TitleText" FontSize="30" TextWrapping="Wrap" />
            <TextBlock x:Name="WhenText" FontSize="20" TextWrapping="Wrap" Margin="0,12,0,0" />
            <TextBlock x:Name="TimeText" FontSize="20" TextWrapping="Wrap" />

            <TextBlock x:Name="ReadOnlyNoteText" FontSize="16" Foreground="#FF4DA6FF" TextWrapping="Wrap" Margin="0,14,0,0" Visibility="Collapsed" />

            <TextBlock Text="Luogo" FontSize="14" Opacity="0.7" Margin="0,18,0,0" />
            <TextBlock x:Name="LocationText" FontSize="18" TextWrapping="Wrap" />

            <TextBlock Text="Calendario" FontSize="14" Opacity="0.7" Margin="0,14,0,0" />
            <TextBlock x:Name="CalendarText" FontSize="18" TextWrapping="Wrap" />

            <TextBlock Text="Promemoria" FontSize="14" Opacity="0.7" Margin="0,14,0,0" />
            <TextBlock x:Name="ReminderText" FontSize="18" TextWrapping="Wrap" />

            <TextBlock Text="Descrizione" FontSize="14" Opacity="0.7" Margin="0,14,0,0" />
            <TextBox x:Name="DetailsBox" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" FontSize="16" MinHeight="120" />
        </StackPanel>
    </ScrollViewer>
</Page>
