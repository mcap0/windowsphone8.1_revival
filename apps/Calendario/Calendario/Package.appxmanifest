<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest" xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest" xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="DumbPhone.Calendario" Publisher="CN=DumbPhone" Version="1.1.3.0" />
  <mp:PhoneIdentity PhoneProductId="1136868c-9484-48f3-bef6-62befd93dad9" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Calendario</DisplayName>
    <PublisherDisplayName>DumbPhone</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="it" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="Calendario.App">
      <m3:VisualElements DisplayName="Calendario"
                         Square150x150Logo="Assets\Square150x150Logo.png"
                         Square44x44Logo="Assets\Square44x44Logo.png"
                         Description="Agenda e mese degli appuntamenti del telefono, incluso Google via Sincro"
                         ForegroundText="light"
                         BackgroundColor="transparent"
                         ToastCapable="false">
        <m3:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" ShortName="Calendario" />
        <m3:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#3949AB" />
      </m3:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <m3:Capability Name="appointments" />
  </Capabilities>
</Package>
