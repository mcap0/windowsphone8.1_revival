<Page
    x:Class="Posta.Pages.MessagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="ReplyButton" Icon="MailReply" Label="Rispondi" Click="ReplyButton_Click" />
            <AppBarButton x:Name="ReplyAllButton" Icon="MailReplyAll" Label="A tutti" Click="ReplyAllButton_Click" />
            <AppBarButton x:Name="ForwardButton" Icon="MailForward" Label="Inoltra" Click="ForwardButton_Click" />
            <AppBarButton x:Name="DeleteButton" Icon="Delete" Label="Elimina" Click="DeleteButton_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="UnreadButton" Icon="Mail" Label="Segna come non letto"
                              Click="UnreadButton_Click" />
                <AppBarToggleButton x:Name="ImagesToggle" Icon="Pictures" Label="Mostra immagini"
                                    Click="ImagesToggle_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid Margin="16,8,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <ProgressBar x:Name="Busy" IsIndeterminate="False" Visibility="Collapsed" />
            <TextBlock x:Name="SubjectText" Style="{StaticResource SubheaderTextBlockStyle}"
                       TextWrapping="Wrap" />
            <TextBlock x:Name="FromText" TextWrapping="Wrap" FontSize="16" />
            <TextBlock x:Name="ToText" TextWrapping="Wrap" FontSize="14" Opacity="0.7" />
            <TextBlock x:Name="DateText" FontSize="14" Opacity="0.7" />
            <TextBlock x:Name="BlockedText" FontSize="14" Opacity="0.7"
                       Margin="0,4,0,0" Visibility="Collapsed" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="14"
                       Margin="0,4,0,0" />
        </StackPanel>

        <ListView x:Name="AttachmentsList" Grid.Row="1" MaxHeight="160"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Attachment_ItemClick" Visibility="Collapsed">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Background="Transparent" Padding="4,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📎" FontSize="18" Margin="0,0,10,0" />
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           FontSize="16" />
                                <TextBlock Text="{Binding SizeText}" FontSize="13" Opacity="0.65" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid Grid.Row="2" Margin="0,8,0,0">
            <ScrollViewer x:Name="PlainScroll" Visibility="Collapsed">
                <TextBlock x:Name="PlainBody" TextWrapping="Wrap" FontSize="18"
                           IsTextSelectionEnabled="True" />
            </ScrollViewer>
            <WebView x:Name="HtmlView" Visibility="Collapsed" ScriptNotify="HtmlView_ScriptNotify"
                     NavigationStarting="HtmlView_NavigationStarting" />
        </Grid>

        <!-- long press on a link: WP8.1 has no clipboard API, so the link goes in a box that is already selected
             and the keyboard's copy key copies it -->
        <Grid x:Name="LinkPanel" Grid.RowSpan="3" Margin="-16,-8,-16,0" Background="#F2000000" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Top" Margin="16,24,16,0">
                <TextBlock Text="Link" Style="{StaticResource SubheaderTextBlockStyle}" />
                <TextBox x:Name="LinkBox" TextWrapping="Wrap" Margin="0,8,0,4" InputScope="Url" />
                <TextBlock Text="Il link è selezionato: tocca copia sulla tastiera." FontSize="14" Opacity="0.7"
                           TextWrapping="Wrap" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Content="apri" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="LinkOpen_Click" />
                    <Button Grid.Column="1" Content="chiudi" MinWidth="0" HorizontalAlignment="Stretch" Margin="4,0,0,0"
                            Click="LinkClose_Click" />
                </Grid>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
