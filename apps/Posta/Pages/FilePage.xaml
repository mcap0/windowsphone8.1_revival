<Page
    x:Class="Posta.Pages.FilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="16,8,16,8">
            <TextBlock Text="Allega file" Style="{StaticResource HeaderTextBlockStyle}" />
            <TextBlock x:Name="PathText" FontSize="14" Opacity="0.65" TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,8,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionStatus" VerticalAlignment="Center" FontSize="14" Opacity="0.65"
                           Text="tocca i file da allegare" />
                <Button Grid.Column="1" Content="Allega" MinWidth="0" Click="Attach_Click" />
            </Grid>
        </StackPanel>
        <ListView x:Name="Entries" Grid.Row="1" IsItemClickEnabled="True" ItemClick="Entries_ItemClick" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="16,6,16,6" Background="{Binding Highlight}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="24" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="14" Opacity="0.65" />
                        </StackPanel>
                    </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
