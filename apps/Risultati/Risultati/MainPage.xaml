<Page
    x:Class="Risultati.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="#FF000000">

    <Grid x:Name="Root" Background="#FF000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>


        <!-- sizes measured on the Bing page (wp_ss_20261022_0002/0007 vs 0003/0005) -->
        <!-- at the top while searching (as on the Bing page), at the bottom under the results (as in the old Bing app) -->
        <Grid x:Name="SearchBar" Grid.Row="0" Margin="19,3,19.65,0">
            <TextBox
                x:Name="SearchBox"
                FontSize="20.5"
                Height="39.1"
                MinHeight="0"
                Margin="0"
                Padding="12.75,0,40,6.8"
                TextWrapping="NoWrap"
                KeyDown="SearchBox_KeyDown">
                <TextBox.InputScope>
                    <InputScope>
                        <InputScope.Names>
                            <InputScopeName NameValue="Search" />
                        </InputScope.Names>
                    </InputScope>
                </TextBox.InputScope>
            </TextBox>
            <!-- the Bing page's own microphone, cut from its screenshot -->
            <Image
                Source="Assets/Mic.png"
                Width="21.25"
                Height="28.75"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Margin="0,2,6.9,0"
                Tapped="Mic_Tapped" />
        </Grid>

        <TextBlock
            x:Name="Status"
            Grid.Row="1"
            Margin="18,20.9,24,10"
            FontFamily="Segoe WP SemiLight"
            FontSize="25.6"
            TextWrapping="Wrap" />

        <!-- Google loads in the IE11 view underneath; the black list covers it (shown alone only as a fallback) -->
        <WebView x:Name="Web" Grid.Row="2" />
        <!-- keeps Google's page hidden while the results are not drawn yet -->
        <Border x:Name="Cover" Grid.Row="2" Background="#FF000000" />
        <!-- web / immagini / locale as in the old Bing app: a real Pivot, swipe between them -->
        <Pivot x:Name="Sections" Grid.Row="2" Background="#FF000000" Visibility="Collapsed"
               SelectionChanged="Sections_SelectionChanged">
            <PivotItem Header="web" Margin="0">
                <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Results" Margin="19,4,19,30" />
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="immagini" Margin="0">
                <ScrollViewer x:Name="ImagesScroller" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ImagesPanel" Margin="19,4,15,30" />
                </ScrollViewer>
            </PivotItem>
            <PivotItem Header="locale" Margin="0">
                <ScrollViewer x:Name="LocalScroller" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LocalPanel" Margin="19,4,19,30" />
                </ScrollViewer>
            </PivotItem>
        </Pivot>
    </Grid>
</Page>
