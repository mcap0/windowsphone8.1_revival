<Page
    x:Class="Registratore.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid Margin="19,12,19,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="REGISTRATORE" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource RecRed}" />

        <StackPanel Grid.Row="1" Margin="0,24,0,16">
            <Grid x:Name="RecordButton" Tapped="Record_Tapped" Width="140" Height="140" HorizontalAlignment="Center">
                <Ellipse Fill="{StaticResource RecRed}" />
                <Ellipse x:Name="RecordDot" Width="48" Height="48" Fill="White" />
                <Rectangle x:Name="StopSquare" Width="44" Height="44" Fill="White" Visibility="Collapsed" />
            </Grid>
            <TextBlock x:Name="TimerText" Text="0:00" FontSize="48" FontWeight="Light" HorizontalAlignment="Center" Margin="0,8,0,0" />
            <TextBlock x:Name="StatusText" Text="Tocca per registrare" HorizontalAlignment="Center" Opacity="0.7"
                       TextWrapping="Wrap" TextAlignment="Center" />
        </StackPanel>

        <ListView x:Name="List" Grid.Row="2" IsItemClickEnabled="True" ItemClick="List_ItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,14" Holding="Item_Holding" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="26" VerticalAlignment="Center"
                                   Foreground="{StaticResource RecRed}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding Title}" FontSize="22" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding Detail}" FontSize="15" Opacity="0.6" />
                        </StackPanel>
                        <Grid Grid.Column="2" Width="52" Height="52" Background="Transparent" Tapped="Delete_Tapped">
                            <SymbolIcon Symbol="Delete" Opacity="0.7" />
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
        <MediaElement x:Name="Player" AutoPlay="True" Volume="1" AudioCategory="ForegroundOnlyMedia"
                      MediaOpened="Player_Opened" CurrentStateChanged="Player_State" Visibility="Collapsed" MediaEnded="Player_Ended" MediaFailed="Player_Failed" />
        <Grid x:Name="MicPanel" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="MICROFONI" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource RecRed}" />
            <TextBlock x:Name="MicStatus" Grid.Row="1" Margin="0,8,0,12" TextWrapping="Wrap" Opacity="0.7" />
            <ListView x:Name="MicList" Grid.Row="2" IsItemClickEnabled="True" ItemClick="Mic_ItemClick" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18" Background="Transparent" Holding="Mic_Holding">
                            <TextBlock Text="{Binding Name}" FontSize="22" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding Detail}" FontSize="15" Opacity="0.6" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
    <Page.BottomAppBar>
        <CommandBar ClosedDisplayMode="Minimal">
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="microfoni" Click="Mics_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
