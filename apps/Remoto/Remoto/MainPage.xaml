<Page
    x:Class="Remoto.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid>
        <!-- The Pixel's screen: our decoder (Core/Video) draws into it at the phone's physical resolution. Touch comes
             from its CoreIndependentInputSource on a thread of its own and goes straight to the Pixel. -->
        <!-- It never turns with the page: in landscape it is counter-rotated (MainPage::Orient) so the phone's pixels
             stay exactly the stream's; the Pixel turns the picture inside the stream instead. A Canvas does not clip
             it (a Grid would, to its landscape slot). -->
        <Canvas x:Name="ScreenHost">
            <SwapChainPanel x:Name="Screen" RenderTransformOrigin="0.5,0.5">
                <SwapChainPanel.RenderTransform>
                    <RotateTransform x:Name="ScreenTurn"/>
                </SwapChainPanel.RenderTransform>
            </SwapChainPanel>
        </Canvas>
        <!-- Lumia keyboard -> Pixel: what is typed here is sent and the box emptied (invisible, takes the focus). -->
        <TextBox x:Name="Typing" IsEnabled="False" Width="2" Height="2" Opacity="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                 IsSpellCheckEnabled="False" IsTextPredictionEnabled="False" BorderThickness="0" MinWidth="0" MinHeight="0"/>
        <!-- Connection state, and the timings when asked for. -->
        <TextBlock x:Name="Status" VerticalAlignment="Top" Margin="8,4" FontSize="13" Foreground="#FFEB3B"
                   TextWrapping="Wrap" IsHitTestVisible="False"/>
        <!-- Copied on the Pixel ('c'): WP8.1 has no clipboard API, so a tap opens the text selected for the system's
             copy button (as Telegram's "Copia"). Hides by itself. -->
        <Border x:Name="CopyBar" Visibility="Collapsed" VerticalAlignment="Top" Background="#F0202020" Padding="16,10"
                Tapped="CopyBar_Tapped">
            <TextBlock x:Name="CopyText" FontSize="17" Foreground="White" TextTrimming="WordEllipsis"/>
        </Border>
        <!-- The Lumia's microphone is the Pixel's right now (an app there records: 'm'). -->
        <TextBlock x:Name="MicBadge" Visibility="Collapsed" Text="&#x25CF; MICROFONO" FontSize="13" FontWeight="SemiBold"
                   Foreground="#FF5252" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8,4"
                   IsHitTestVisible="False"/>
        <!-- Remoto's menu: swipe up from the bottom edge (MainPage::Touch). Our own panel, not an app bar: a system
             bar takes the touches of its strip even when transparent. Back or a tap above it closes it. -->
        <Grid x:Name="MenuPanel" Visibility="Collapsed" Background="#60000000" Tapped="MenuPanel_Tapped">
            <!-- scrolls when the buttons do not fit (landscape, or more entries than the screen holds) -->
            <ScrollViewer VerticalAlignment="Bottom" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
            <StackPanel Background="#F0181818" Tapped="MenuBox_Tapped">
                <StackPanel.Resources>
                    <Style TargetType="Button">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Padding" Value="19,12"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="FontSize" Value="22"/>
                        <Setter Property="FontWeight" Value="Light"/>
                    </Style>
                </StackPanel.Resources>
                <Button Content="app" Click="Apps_Click"/>
                <Button Content="app aperte" Click="OpenApps_Click"/>
                <Button Content="tastiera" Click="Keyboard_Click"/>
                <Button Content="incolla dal Lumia" Click="Paste_Click"/>
                <Button x:Name="RestartButton" Content="riavvia l'app" Click="Restart_Click"/>
                <Button x:Name="StatsButton" Content="mostra i tempi" Click="Stats_Click"/>
                <Button Content="ricollega" Click="Reconnect_Click"/>
                <Button x:Name="TsOnlyButton" Content="solo Tailscale" Click="TsOnly_Click"/>
                <Button x:Name="PunchButton" Content="attiva hole punching" Click="Punch_Click"/>
                <Button x:Name="ServerButton" Content="usa il banco del PC" Click="Server_Click"/>
                <Button Content="scarica la chiave del ponte" Click="Pair_Click" Margin="0,0,0,12"/>
            </StackPanel>
            </ScrollViewer>
        </Grid>
        <!-- The Pixel's lock prompt (PIN): it is a secure window on the Pixel's own screen that no capture shows, so
             the PIN is entered here and typed there ('Y'). Back cancels it ('Z'). -->
        <Grid x:Name="PinPanel" Background="Black" Visibility="Collapsed">
            <Grid VerticalAlignment="Center" Margin="24,0">
                <Grid.Resources>
                    <Style TargetType="Button">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="4"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="MinWidth" Value="0"/>
                        <Setter Property="Height" Value="76"/>
                        <Setter Property="FontSize" Value="30"/>
                        <Setter Property="FontWeight" Value="Light"/>
                    </Style>
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/><ColumnDefinition/><ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="PinTitle" Grid.ColumnSpan="3" Text="PIN DEL PIXEL" FontSize="15" FontWeight="SemiBold"
                           Foreground="#A0A0A0" Margin="4,0,4,8" TextWrapping="Wrap"/>
                <TextBlock x:Name="PinDots" Grid.Row="1" Grid.ColumnSpan="3" FontSize="40" Margin="4,0,4,16" Height="56"
                           Foreground="White"/>
                <Button Content="1" Grid.Row="2" Grid.Column="0" Click="PinKey_Click"/>
                <Button Content="2" Grid.Row="2" Grid.Column="1" Click="PinKey_Click"/>
                <Button Content="3" Grid.Row="2" Grid.Column="2" Click="PinKey_Click"/>
                <Button Content="4" Grid.Row="3" Grid.Column="0" Click="PinKey_Click"/>
                <Button Content="5" Grid.Row="3" Grid.Column="1" Click="PinKey_Click"/>
                <Button Content="6" Grid.Row="3" Grid.Column="2" Click="PinKey_Click"/>
                <Button Content="7" Grid.Row="4" Grid.Column="0" Click="PinKey_Click"/>
                <Button Content="8" Grid.Row="4" Grid.Column="1" Click="PinKey_Click"/>
                <Button Content="9" Grid.Row="4" Grid.Column="2" Click="PinKey_Click"/>
                <Button Content="&#9003;" Grid.Row="5" Grid.Column="0" Click="PinKey_Click"/>
                <Button Content="0" Grid.Row="5" Grid.Column="1" Click="PinKey_Click"/>
                <Button Content="OK" Grid.Row="5" Grid.Column="2" Click="PinKey_Click"/>
            </Grid>
        </Grid>
        <!-- The apps open on the Pixel's display ('q' -> 'o'): tap a name = bring it to the front, "chiudi" = close
             it as Recents would ('x'), "chiudi tutte" = all of them. Rows are made in code (ShowOpen). -->
        <Grid x:Name="OpenPanel" Background="Black" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="19,24,19,8">
                <TextBlock Text="APP APERTE SUL PIXEL" FontSize="15" FontWeight="SemiBold" Foreground="#A0A0A0"/>
                <Button x:Name="CloseAllButton" Content="chiudi tutte" Click="CloseAll_Click" HorizontalAlignment="Stretch"
                        MinWidth="0" Margin="0,12,0,8" FontSize="22" FontWeight="Light"/>
            </StackPanel>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="OpenList" Margin="19,0,19,80"/>
            </ScrollViewer>
        </Grid>
        <!-- The Pixel's apps. -->
        <Grid x:Name="AppsPanel" Background="Black" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="19,24,19,8">
                <TextBlock Text="APP DEL PIXEL" FontSize="15" FontWeight="SemiBold" Foreground="#A0A0A0"/>
                <TextBox x:Name="Search" PlaceholderText="cerca" Margin="0,8,0,0" IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False"/>
            </StackPanel>
            <!-- tap = open, hold = open or restart -->
            <ListView x:Name="AppList" Grid.Row="1" IsItemClickEnabled="True" SelectionMode="None" ItemClick="AppList_ItemClick"
                      Padding="19,0,19,80">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="26" FontWeight="Light" Padding="0,6" Foreground="White"
                                   Holding="AppItem_Holding"/>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
