<Page
    x:Class="Cerca.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark"
    Background="#FF000000"
    Loaded="Page_Loaded">

    <Grid Background="#FF000000">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="20,28,20,10">
            <TextBox
                x:Name="SearchBox"
                FontSize="30"
                MinHeight="68"
                Padding="12,8"
                Foreground="#FFFFFFFF"
                Background="#FF202020"
                BorderBrush="#FF666666"
                PlaceholderText="Cerca nel web"
                TextWrapping="NoWrap"
                TextChanged="SearchBox_TextChanged"
                KeyDown="SearchBox_KeyDown">
                <TextBox.InputScope>
                    <InputScope>
                        <InputScope.Names>
                            <InputScopeName NameValue="Search" />
                        </InputScope.Names>
                    </InputScope>
                </TextBox.InputScope>
            </TextBox>

            <TextBlock
                Margin="2,10,2,12"
                FontSize="18"
                Foreground="#FFBDBDBD"
                Text="Scrivi una ricerca o un indirizzo web" />

            <Button
                Content="QR (presto)"
                IsEnabled="False"
                HorizontalAlignment="Left"
                MinWidth="150"
                FontSize="18" />
        </StackPanel>

        <ListView
            x:Name="SuggestionsList"
            Grid.Row="1"
            Margin="10,0,10,10"
            IsItemClickEnabled="True"
            ItemClick="Suggestions_ItemClick"
            Background="#FF000000"
            Foreground="#FFFFFFFF">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding}"
                        FontSize="23"
                        TextWrapping="Wrap"
                        Margin="8,10" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
