<Page x:Class="Authenticator.AddPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <ScrollViewer>
    <StackPanel Margin="16,12">
      <TextBlock Text="AGGIUNGI ACCOUNT" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
      <Button Content="scansiona QR code" HorizontalAlignment="Stretch" Click="OnScan" />
      <TextBlock Text="oppure incolla un link otpauth://" Margin="0,16,0,4" Opacity="0.7" />
      <TextBox x:Name="UriBox" PlaceholderText="otpauth://totp/..." InputScope="Url" />
      <TextBlock Text="oppure inserisci a mano" Margin="0,16,0,4" Opacity="0.7" />
      <TextBox x:Name="IssuerBox" Header="servizio" PlaceholderText="es. GitHub" />
      <TextBox x:Name="LabelBox" Header="account" PlaceholderText="es. nome@esempio.it" Margin="0,8,0,0" />
      <TextBox x:Name="SecretBox" Header="codice segreto" PlaceholderText="JBSWY3DPEHPK3PXP" Margin="0,8,0,0" InputScope="AlphanumericFullWidth" />
      <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,12,0,0" />
      <Button Content="salva" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="OnSave" />
    </StackPanel>
  </ScrollViewer>
</Page>
