<Page
    x:Class="File.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000"
    Foreground="#FFFFFFFF">
    <Page.Resources>
        <DataTemplate x:Key="FileEntryTemplate">
            <Grid Height="72" Margin="12,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}"
                           FontFamily="Segoe UI Symbol"
                           FontSize="28"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}"
                               FontSize="20"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Details}"
                               FontSize="13"
                               Opacity="0.68"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <Grid Margin="8,3">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="46" />
            <RowDefinition Height="30" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid Margin="8,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="52" />
                <ColumnDefinition Width="54" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PathBox"
                     VerticalAlignment="Center"
                     FontSize="16"
                     KeyDown="PathBox_KeyDown" />
            <Button x:Name="UpButton"
                    Grid.Column="1"
                    Content="↑"
                    FontSize="23"
                    Padding="0"
                    Margin="3,0" />
            <Button x:Name="GoButton"
                    Grid.Column="2"
                    Content="vai"
                    FontSize="16"
                    Padding="4,0"
                    Margin="2,0" />
        </Grid>
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Hidden"
                      VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="PlacesPanel"
                        Orientation="Horizontal"
                        VerticalAlignment="Center"
                        Margin="5,0" />
        </ScrollViewer>
        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="12,2"
                   FontSize="13"
                   Opacity="0.8"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <ListView x:Name="FilesList"
                  Grid.Row="3"
                  Background="Transparent"
                  BorderThickness="0"
                  ItemTemplate="{StaticResource FileEntryTemplate}"
                  IsItemClickEnabled="True"
                  SelectionMode="None" />
    </Grid>
</Page>
