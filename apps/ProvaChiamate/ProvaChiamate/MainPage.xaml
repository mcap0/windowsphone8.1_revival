<Page
    x:Class="ProvaChiamate.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid Margin="12,8,12,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel x:Name="Buttons" />
        <ScrollViewer x:Name="LogScroll" Grid.Row="1" Margin="0,8,0,0">
            <TextBlock x:Name="LogText" FontSize="16" Foreground="White" TextWrapping="Wrap" />
        </ScrollViewer>
    </Grid>
</Page>
