<Page
    x:Class="Sincro.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <ScrollViewer>
        <StackPanel Margin="16,12,16,16">
            <TextBlock Text="Accesso Google" FontSize="32" />
            <TextBlock FontSize="14" TextWrapping="Wrap" Opacity="0.8" Margin="0,4,0,12"
                       Text="Sul PC: esegui tools/google-auth e accedi con il tuo account Google. Poi qui tocca Importa dal PC." />

            <TextBlock Text="Indirizzo" FontSize="14" Opacity="0.7" />
            <TextBox x:Name="AddressBox" InputScope="Url" Margin="0,0,0,8" />
            <Button Content="Importa dal PC" HorizontalAlignment="Stretch" Click="Import_Click" Margin="0,0,0,12" />

            <TextBlock x:Name="StatusText" FontSize="16" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock x:Name="ErrorText" FontSize="14" TextWrapping="Wrap" Foreground="#FFE81123" Margin="0,0,0,12" />

            <Button Content="Disconnetti" HorizontalAlignment="Stretch" Click="Disconnect_Click" Margin="0,0,0,8" />
            <Button Content="Rimuovi dati sincronizzati" HorizontalAlignment="Stretch" Click="Wipe_Click" Margin="0,0,0,8" />
        </StackPanel>
    </ScrollViewer>
</Page>
