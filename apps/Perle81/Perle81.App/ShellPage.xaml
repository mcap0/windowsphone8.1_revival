<Page x:Class="Perle81.App.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid x:Name="Root">
    <Frame x:Name="AppFrame" x:FieldModifier="public" />

    <Grid x:Name="MiniBar" Height="72" VerticalAlignment="Bottom" Background="#F0222222"
          Visibility="Collapsed" Tapped="OnMiniBarTapped">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="128" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>
      <Border x:Name="MiniVideoSlot" Grid.Column="0" Background="#FF111111" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0" IsHitTestVisible="False">
        <TextBlock x:Name="MiniTitle" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock x:Name="MiniUploader" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>
      <!-- plain tappable areas: phone Buttons have a minimum width that does not fit the bar -->
      <Border Grid.Column="2" Background="Transparent" Tapped="OnPlayPauseTapped">
        <TextBlock x:Name="PlayPauseGlyph" Text="&#x2161;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Border Grid.Column="3" Background="Transparent" Tapped="OnCloseTapped">
        <TextBlock Text="&#x00D7;" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <Grid x:Name="PlayerHost" HorizontalAlignment="Left" VerticalAlignment="Top"
          Background="Black" Visibility="Collapsed" IsHitTestVisible="False">
      <Border x:Name="HostSubtitleBox" HorizontalAlignment="Center" VerticalAlignment="Bottom"
              Margin="12,0,12,12" Padding="8,5" Background="#B8000000"
              Visibility="{Binding Visibility, ElementName=HostSubtitle}">
        <TextBlock x:Name="HostSubtitle" Foreground="White" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"
                   Visibility="Collapsed" />
      </Border>
    </Grid>
  </Grid>
</Page>
