<Page x:Class="Perle81.App.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="VideoArea" Background="Black" Tapped="OnVideoTapped">
      <ProgressRing x:Name="Busy" IsActive="True" Width="48" Height="48" />
    </Grid>
    <ScrollViewer x:Name="InfoArea" Grid.Row="1">
      <StackPanel Margin="12,8">
        <TextBlock x:Name="TitleText" FontSize="18" TextWrapping="Wrap" />
        <TextBlock x:Name="MetaText" FontSize="13" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="QualityText" FontSize="13" Opacity="0.8" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="DescriptionText" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" IsTextSelectionEnabled="True" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <Page.BottomAppBar>
    <CommandBar x:Name="Commands" ClosedDisplayMode="Compact">
      <CommandBar.SecondaryCommands>
        <AppBarButton x:Name="AudioCommand" Label="traccia audio" Click="OnAudioCommandClick" Visibility="Collapsed" />
        <AppBarButton x:Name="SubtitleCommand" Label="sottotitoli" Click="OnSubtitleCommandClick" />
      </CommandBar.SecondaryCommands>
      <AppBarButton Label="Schermo intero" Icon="FullScreen" Click="OnFullscreenClick" />
      <AppBarButton Label="Scarica audio" Icon="Download" Click="OnDownloadAudio" />
    </CommandBar>
  </Page.BottomAppBar>
</Page>
