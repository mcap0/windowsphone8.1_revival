<Page
    x:Class="Orologio.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000"
    Foreground="#FFFFFFFF">

  <Grid>
  <!-- the timer alarm while the app is open: a looping beep until "ferma" -->
  <MediaElement x:Name="AlarmPlayer" Source="ms-appx:///Assets/alarm.wav" AutoPlay="False"
                IsLooping="True" AudioCategory="Alerts" Width="0" Height="0" />
  <Pivot x:Name="Tabs" Title="OROLOGIO" SelectionChanged="Tabs_SelectionChanged">
    <PivotItem Header="ora">
      <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="8,0">
          <!-- the Viewbox shrinks the digits to the screen width instead of cutting them -->
          <Viewbox StretchDirection="DownOnly">
            <TextBlock x:Name="ClockTextBlock"
                       Text="00:00:00"
                       FontSize="110"
                       FontWeight="Light" />
          </Viewbox>
          <TextBlock x:Name="DateTextBlock"
                     Text=""
                     FontSize="22"
                     TextAlignment="Center"
                     TextWrapping="Wrap"
                     Margin="0,4,0,8" />
          <TextBlock x:Name="NtpStatusTextBlock"
                     Text="ora non verificata (rete)"
                     FontSize="14"
                     Opacity="0.75"
                     TextAlignment="Center"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </PivotItem>

    <PivotItem Header="cronometro">
      <Grid Margin="12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Viewbox StretchDirection="DownOnly" Margin="0,28,0,18">
          <TextBlock x:Name="StopwatchTextBlock"
                     Text="00:00,00"
                     FontSize="88"
                     FontWeight="Light" />
        </Viewbox>

        <!-- equal columns: phone buttons have a minimum width, fixed widths spill out of the screen -->
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button x:Name="StopwatchToggleButton" Grid.Column="0" Content="avvia" MinWidth="0" HorizontalAlignment="Stretch"
                  Margin="0,0,4,0" Click="StopwatchToggle_Click" />
          <Button x:Name="StopwatchLapButton" Grid.Column="1" Content="giro" MinWidth="0" HorizontalAlignment="Stretch"
                  Margin="2,0" IsEnabled="False" Click="StopwatchLap_Click" />
          <Button x:Name="StopwatchResetButton" Grid.Column="2" Content="azzera" MinWidth="0" HorizontalAlignment="Stretch"
                  Margin="4,0,0,0" IsEnabled="False" Click="StopwatchReset_Click" />
        </Grid>

        <ListView x:Name="LapsList"
                  Grid.Row="2"
                  Margin="0,8,0,0"
                  SelectionMode="None" />
      </Grid>
    </PivotItem>

    <PivotItem x:Name="TimerPivot" Header="timer">
      <Grid Margin="12,0">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="TimerPickerPanel" Grid.Row="0">
          <!-- buttons that open a full-page list: the phone ComboBox loses its right border in narrow cells -->
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,4,0">
              <TextBlock Text="ore" FontSize="14" Opacity="0.7" HorizontalAlignment="Center" />
              <Button x:Name="HoursBox" Content="00" Tag="h" MinWidth="0" HorizontalAlignment="Stretch" FontSize="24" Click="PickTime_Click" />
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="2,0">
              <TextBlock Text="minuti" FontSize="14" Opacity="0.7" HorizontalAlignment="Center" />
              <Button x:Name="MinutesBox" Content="00" Tag="m" MinWidth="0" HorizontalAlignment="Stretch" FontSize="24" Click="PickTime_Click" />
            </StackPanel>
            <StackPanel Grid.Column="2" Margin="4,0,0,0">
              <TextBlock Text="secondi" FontSize="14" Opacity="0.7" HorizontalAlignment="Center" />
              <Button x:Name="SecondsBox" Content="00" Tag="s" MinWidth="0" HorizontalAlignment="Stretch" FontSize="24" Click="PickTime_Click" />
            </StackPanel>
          </Grid>

          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="1 min" Tag="60" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="QuickTimer_Click" />
            <Button Grid.Column="1" Content="3 min" Tag="180" MinWidth="0" HorizontalAlignment="Stretch" Margin="2,0" Click="QuickTimer_Click" />
            <Button Grid.Column="2" Content="5 min" Tag="300" MinWidth="0" HorizontalAlignment="Stretch" Margin="4,0,0,0" Click="QuickTimer_Click" />
          </Grid>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Content="10 min" Tag="600" MinWidth="0" HorizontalAlignment="Stretch" Margin="0,0,4,0" Click="QuickTimer_Click" />
            <Button Grid.Column="1" Content="15 min" Tag="900" MinWidth="0" HorizontalAlignment="Stretch" Margin="2,0" Click="QuickTimer_Click" />
            <Button Grid.Column="2" Content="30 min" Tag="1800" MinWidth="0" HorizontalAlignment="Stretch" Margin="4,0,0,0" Click="QuickTimer_Click" />
          </Grid>
        </StackPanel>

        <Viewbox Grid.Row="1" StretchDirection="DownOnly" Margin="0,14,0,12">
          <TextBlock x:Name="TimerTextBlock"
                     Text="00:00"
                     FontSize="88"
                     FontWeight="Light" />
        </Viewbox>

        <Grid Grid.Row="2">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
          <Button x:Name="TimerActionButton" Grid.Column="0" Content="avvia" MinWidth="0" HorizontalAlignment="Stretch"
                  Margin="0,0,4,0" Click="TimerAction_Click" />
          <Button x:Name="TimerCancelButton" Grid.Column="1" Content="annulla" MinWidth="0" HorizontalAlignment="Stretch"
                  Margin="4,0,0,0" IsEnabled="False" Click="TimerCancel_Click" />
        </Grid>
      </Grid>
    </PivotItem>

    <PivotItem Header="sveglie">
      <Grid>
        <TextBlock x:Name="AlarmsEmpty" Text="nessuna sveglia: tocca + per crearne una" FontSize="20" Opacity="0.7"
                   TextWrapping="Wrap" Margin="12,8" Visibility="Collapsed" />
        <!-- rows built in code: time, label and days, on/off switch; tap = edit, hold = delete -->
        <ListView x:Name="AlarmsList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="Alarm_Click" />
      </Grid>
    </PivotItem>
  </Pivot>
  </Grid>

  <Page.BottomAppBar>
    <CommandBar>
      <AppBarButton x:Name="AddAlarmButton" Icon="Add" Label="nuova" Visibility="Collapsed" Click="AddAlarm_Click" />
      <AppBarButton Icon="Refresh" Label="sincronizza" Click="Sync_Click" />
    </CommandBar>
  </Page.BottomAppBar>
</Page>
