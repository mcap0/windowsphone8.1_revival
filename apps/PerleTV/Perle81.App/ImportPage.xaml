<Page x:Class="Perle81.App.ImportPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <StackPanel Margin="12,24">
    <TextBlock Text="Importa iscrizioni" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />
    <ProgressBar x:Name="Busy" IsIndeterminate="True" />
    <TextBlock x:Name="Message" TextWrapping="Wrap" Margin="0,12,0,0" Text="Lettura del file…" />
    <Button x:Name="DoneButton" Content="Apri Perle" Click="OnDone" Visibility="Collapsed" Margin="0,16,0,0" />
  </StackPanel>
</Page>
