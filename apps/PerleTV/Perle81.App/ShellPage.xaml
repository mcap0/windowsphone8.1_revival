<Page x:Class="Perle81.App.ShellPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid x:Name="Root">
    <Frame x:Name="AppFrame" x:FieldModifier="public" />

    <Grid x:Name="MiniBar" Height="72" VerticalAlignment="Bottom" Background="#F0222222"
          Visibility="Collapsed" Tapped="OnMiniBarTapped">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="128" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="56" />
        <ColumnDefinition Width="56" />
      </Grid.ColumnDefinitions>
      <Border x:Name="MiniVideoSlot" Grid.Column="0" Background="#FF111111">
        <TextBlock x:Name="MiniTvGlyph" Text="TV" FontSize="22" Opacity="0.8" Visibility="Collapsed"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,4,0" IsHitTestVisible="False">
        <TextBlock x:Name="MiniTitle" FontSize="15" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock x:Name="MiniUploader" FontSize="12" Opacity="0.7" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
      </StackPanel>
      <!-- plain tappable areas: phone Buttons have a minimum width that does not fit the bar -->
      <Border Grid.Column="2" Background="Transparent" Tapped="OnPlayPauseTapped">
        <TextBlock x:Name="PlayPauseGlyph" Text="&#x2161;" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
      <Border x:Name="MiniClose" Grid.Column="3" Background="Transparent" Tapped="OnCloseTapped">
        <TextBlock Text="&#x00D7;" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Border>
    </Grid>

    <Grid x:Name="PlayerHost" HorizontalAlignment="Left" VerticalAlignment="Top"
          Background="Black" Visibility="Collapsed" IsHitTestVisible="False">
      <!-- our own controls over the video (the MediaElement's built-in ones are off: their double tap and
           full-window button put the video above the whole app with no way back) -->
      <Grid x:Name="VideoGestures" Background="Transparent" Tapped="OnVideoTapped" DoubleTapped="OnVideoDoubleTapped">
        <TextBlock x:Name="SeekFlash" FontSize="28" Foreground="White" VerticalAlignment="Center"
                   Margin="40,0" Visibility="Collapsed" IsHitTestVisible="False" />
        <Grid x:Name="VideoControls" VerticalAlignment="Bottom" Background="#B0000000" Visibility="Collapsed">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="52" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="52" />
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="Transparent" Tapped="OnControlsPlayTapped">
            <TextBlock x:Name="ControlsPlayGlyph" Text="&#xE102;" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock x:Name="ControlsPosition" Grid.Column="1" FontSize="13" Foreground="White"
                     VerticalAlignment="Center" Margin="2,0,6,0" />
          <Slider x:Name="ControlsSeek" Grid.Column="2" Minimum="0" Maximum="1" StepFrequency="1"
                  IsThumbToolTipEnabled="False" VerticalAlignment="Center" Margin="0,-10,0,-18"
                  ValueChanged="OnControlsSeekChanged" Tapped="OnControlsInnerTapped" />
          <TextBlock x:Name="ControlsDuration" Grid.Column="3" FontSize="13" Foreground="White"
                     VerticalAlignment="Center" Margin="6,0,2,0" />
          <Border Grid.Column="4" Background="Transparent" Tapped="OnControlsFullscreenTapped">
            <TextBlock x:Name="ControlsFullscreenGlyph" Text="&#xE1D9;" FontFamily="Segoe UI Symbol" FontSize="22" Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
        </Grid>
      </Grid>
      <Border x:Name="HostSubtitleBox" HorizontalAlignment="Center" VerticalAlignment="Bottom" IsHitTestVisible="False"
              Margin="12,0,12,12" Padding="8,5" Background="#B8000000"
              Visibility="{Binding Visibility, ElementName=HostSubtitle}">
        <TextBlock x:Name="HostSubtitle" Foreground="White" FontSize="20" TextAlignment="Center" TextWrapping="Wrap"
                   Visibility="Collapsed" />
      </Border>
    </Grid>
  </Grid>
</Page>
