<Page x:Class="Perle81.App.ChannelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Margin="12,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="Header" Text="Canale" FontSize="22" TextWrapping="Wrap" VerticalAlignment="Center" />
        <Button x:Name="SubscribeButton" Grid.Column="1" Content="Iscriviti" Click="OnSubscribeClick" Margin="10,0,0,0"
                MinWidth="0" Visibility="Collapsed" />
      </Grid>
      <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed" />
      <TextBlock x:Name="Status" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
    </StackPanel>
    <ListView x:Name="List" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnVideoClick">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="12,6" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="160" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="160" Height="90" Background="#222">
              <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
              <Border Background="#CC000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,1">
                <TextBlock Text="{Binding DurationText}" FontSize="12" />
              </Border>
            </Grid>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="15" />
              <TextBlock Text="{Binding Details}" FontSize="12" Opacity="0.7" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
    <Button x:Name="MoreButton" Grid.Row="2" Content="altri video" Click="OnMoreClick" Margin="12,6" HorizontalAlignment="Stretch" Visibility="Collapsed" />
  </Grid>
</Page>
