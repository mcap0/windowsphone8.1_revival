<Page x:Class="Perle81.App.PlayerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid x:Name="VideoArea" Background="Black" Tapped="OnVideoTapped">
      <ProgressRing x:Name="Busy" IsActive="True" Width="48" Height="48" />
    </Grid>
    <ScrollViewer x:Name="InfoArea" Grid.Row="1">
      <StackPanel Margin="12,8">
        <TextBlock x:Name="TitleText" FontSize="18" TextWrapping="Wrap" />
        <TextBlock x:Name="MetaText" FontSize="13" Opacity="0.7" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="QualityText" FontSize="13" Opacity="0.8" Margin="0,8,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="ErrorText" Foreground="OrangeRed" TextWrapping="Wrap" Margin="0,8,0,0" />
        <TextBlock x:Name="DescriptionText" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0" IsTextSelectionEnabled="True" />
        <TextBlock x:Name="RelatedHeader" Text="consigliati" FontSize="22" Margin="0,20,0,4" Visibility="Collapsed" />
        <ItemsControl x:Name="RelatedList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid Margin="0,6" Background="Transparent" Tapped="OnRelatedTapped" Holding="OnRelatedHolding">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="160" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="160" Height="90" Background="#222">
                  <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                  <Border Background="#CC000000" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="4,1">
                    <TextBlock Text="{Binding DurationText}" FontSize="12" />
                  </Border>
                </Grid>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                  <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="15" MaxLines="3" />
                  <TextBlock Text="{Binding Uploader}" FontSize="12" Opacity="0.7" Margin="0,4,0,0" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </ScrollViewer>
  </Grid>
  <Page.BottomAppBar>
    <CommandBar x:Name="Commands" ClosedDisplayMode="Compact">
      <CommandBar.SecondaryCommands>
        <AppBarButton x:Name="AudioCommand" Label="traccia audio" Click="OnAudioCommandClick" Visibility="Collapsed" />
        <AppBarButton x:Name="SubtitleCommand" Label="sottotitoli" Click="OnSubtitleCommandClick" />
        <AppBarButton x:Name="QualityCommand" Label="qualità" Click="OnQualityCommandClick" />
        <AppBarButton x:Name="LaterCommand" Label="guarda dopo" Click="OnLaterCommandClick" />
        <AppBarButton x:Name="ChannelCommand" Label="vai al canale" Click="OnChannelCommandClick" Visibility="Collapsed" />
        <AppBarButton x:Name="SubscribeCommand" Label="iscriviti al canale" Click="OnSubscribeCommandClick" Visibility="Collapsed" />
        <AppBarButton x:Name="BackgroundAudioCommand" Label="audio in sottofondo" Click="OnBackgroundAudioClick" Visibility="Collapsed" />
      </CommandBar.SecondaryCommands>
      <AppBarButton Label="Schermo intero" Icon="FullScreen" Click="OnFullscreenClick" />
      <AppBarButton Label="Scarica audio" Icon="Download" Click="OnDownloadAudio" />
      <AppBarButton Label="trasmetti" Icon="Go" Click="OnCastClick" />
    </CommandBar>
  </Page.BottomAppBar>
</Page>
