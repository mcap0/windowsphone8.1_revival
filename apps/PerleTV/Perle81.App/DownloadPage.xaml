<Page x:Class="Perle81.App.DownloadPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <TextBlock Text="Download" FontSize="24" FontWeight="SemiBold" Margin="12,8,12,4" />
    <TextBlock x:Name="EmptyText" Grid.Row="1" Margin="12" TextWrapping="Wrap" Visibility="Collapsed"
               Text="Nessun download. Da un video scegli Scarica audio." />
    <ListView x:Name="List" Grid.Row="1" SelectionMode="None">
      <ListView.ItemContainerStyle>
        <Style TargetType="ListViewItem">
          <Setter Property="HorizontalContentAlignment" Value="Stretch" />
          <Setter Property="Padding" Value="12,6" />
        </Style>
      </ListView.ItemContainerStyle>
      <ListView.ItemTemplate>
        <DataTemplate>
          <StackPanel>
            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="15" />
            <TextBlock Text="{Binding Uploader}" FontSize="12" Opacity="0.7" />
            <ProgressBar Value="{Binding Progress}" Maximum="100" Margin="0,4,0,0" />
            <TextBlock Text="{Binding Message}" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Button Content="Riprova" IsEnabled="{Binding CanRetry}" Click="OnRetry" Margin="0,0,8,0" />
              <Button Content="{Binding DeleteLabel}" IsEnabled="{Binding CanDelete}" Click="OnDelete" />
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
