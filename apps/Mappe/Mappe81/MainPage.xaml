<Page
    x:Class="Mappe81.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF101010">

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Map" Label="posizione" Click="Locate_Click" />
            <AppBarButton Icon="ZoomIn" Label="zoom +" Click="ZoomIn_Click" />
            <AppBarButton Icon="ZoomOut" Label="zoom -" Click="ZoomOut_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="invia schermata al PC" Click="Shot_Click" />
                <AppBarButton Label="aggiorna la mappa" Click="Download_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>

    <Grid>
        <SwapChainPanel x:Name="MapPanel" />
        <Border VerticalAlignment="Top" Background="#CC101010" Padding="12,6,12,6">
            <TextBlock x:Name="StatusText" FontSize="15" Foreground="#FFFFD54F" TextWrapping="Wrap" Text="Avvio..." />
        </Border>
        <Border VerticalAlignment="Bottom" Background="#AA000000" Padding="6,2,6,2">
            <TextBlock Text="© OpenStreetMap contributors · Navit" FontSize="12" Foreground="#FFFFFFFF" HorizontalAlignment="Center" />
        </Border>
        <MediaElement x:Name="Voice" AutoPlay="True" Width="0" Height="0" />
    </Grid>
</Page>
