<Page
    x:Class="Esplora.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000"
    Foreground="#FFFFFFFF">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="FileNameText"
                   Margin="14,4"
                   FontSize="22"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StatusText"
                   Grid.Row="1"
                   Margin="14,0,14,4"
                   FontSize="13"
                   Opacity="0.82"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <TextBox x:Name="EditorText"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 TextWrapping="Wrap"
                 FontSize="18"
                 FontFamily="Consolas"
                 Padding="12,8"
                 BorderThickness="0" />
    </Grid>
</Page>
