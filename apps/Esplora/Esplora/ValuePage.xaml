<Page
    x:Class="Esplora.ValuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000"
    Foreground="#FFFFFFFF">
  <ScrollViewer>
    <StackPanel Margin="14,10">
      <TextBlock x:Name="KeyText" FontSize="14" Opacity="0.75" TextWrapping="Wrap" />
      <TextBlock Text="Nome" FontSize="14" Margin="0,10,0,0" Opacity="0.7" />
      <TextBox x:Name="NameBox" FontSize="18" />
      <TextBlock Text="Tipo" FontSize="14" Margin="0,6,0,0" Opacity="0.7" />
      <ComboBox x:Name="TypeBox" FontSize="18" />
      <TextBlock Text="Dati" FontSize="14" Margin="0,6,0,0" Opacity="0.7" />
      <TextBox x:Name="DataBox" FontSize="16" FontFamily="Consolas" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="140" />
      <TextBlock x:Name="StatusText" FontSize="14" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#FFFFB74D" />
    </StackPanel>
  </ScrollViewer>
</Page>
