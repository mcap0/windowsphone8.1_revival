<Page
    x:Class="FotoPixel.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton x:Name="SendButton" Label="invia" Icon="Send" Click="OnSend" IsEnabled="False" />
            <AppBarButton x:Name="ClearButton" Label="deseleziona" Icon="Cancel" Click="OnClear" IsEnabled="False" />
            <AppBarButton Label="aggiorna" Icon="Refresh" Click="OnRefresh" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Label="Tailscale" Click="OnTailscale" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid Margin="12,0,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="FOTO AL PIXEL" Style="{ThemeResource TitleTextBlockStyle}" Margin="0,12,0,0" />
        <TextBlock x:Name="Status" Grid.Row="1" Text="cerco il Pixel…" TextWrapping="Wrap" FontSize="18"
                   Foreground="#FF9AA0A6" Margin="0,4,12,8" />
        <GridView x:Name="Photos" Grid.Row="2" SelectionMode="Multiple" IsItemClickEnabled="False"
                  SelectionChanged="OnSelectionChanged" ContainerContentChanging="OnContainerContentChanging">
            <GridView.ItemContainerStyle>
                <Style TargetType="GridViewItem">
                    <Setter Property="Margin" Value="0,0,3,3" />
                </Style>
            </GridView.ItemContainerStyle>
            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="120" Height="120" Background="#FF1E1E1E">
                        <Image Stretch="UniformToFill" />
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Background="#E0107C10"
                                Padding="6,1,6,2" Visibility="Collapsed">
                            <TextBlock Text="inviata" FontSize="14" Foreground="White" />
                        </Border>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Background="#D0000000"
                                Padding="6,1,6,2" Visibility="Collapsed">
                            <TextBlock FontSize="14" Foreground="White" TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>
    </Grid>
</Page>
