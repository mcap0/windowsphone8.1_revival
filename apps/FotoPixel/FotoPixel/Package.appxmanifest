<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest"
         xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest"
         xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest"
         xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="DumbPhone.FotoPixel" Publisher="CN=DumbPhone" Version="1.1.2.0" />
  <mp:PhoneIdentity PhoneProductId="9dce49e3-42b3-43e8-9cd4-5bb5843d3b1c" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>Foto al Pixel</DisplayName>
    <PublisherDisplayName>DumbPhone</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="it" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="FotoPixel.App">
      <m3:VisualElements DisplayName="Foto al Pixel"
                         Square150x150Logo="Assets\Square150x150Logo.png"
                         Square44x44Logo="Assets\Square44x44Logo.png"
                         Description="Manda le foto del Rullino al Pixel 2 XL (backup su Google Foto)"
                         ForegroundText="light"
                         BackgroundColor="transparent">
        <m3:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
        <m3:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#37474F" />
      </m3:VisualElements>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="picturesLibrary" />
  </Capabilities>
</Package>
