<Page
    x:Class="Authenticator.EditPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF000000">
    <ScrollViewer>
        <StackPanel Margin="16,12,16,24">
            <TextBlock Text="RINOMINA" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
            <TextBox x:Name="IssuerBox" Header="servizio" />
            <TextBox x:Name="LabelBox" Header="account" Margin="0,8,0,0" />
            <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B" TextWrapping="Wrap" Margin="0,12,0,0" />
            <Button Content="salva" HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="OnSave" />
        </StackPanel>
    </ScrollViewer>
</Page>
