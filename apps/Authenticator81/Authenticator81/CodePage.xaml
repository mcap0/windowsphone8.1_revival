<Page
    x:Class="Authenticator.CodePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="OnLoaded"
    Background="#FF000000">
    <Grid Margin="16,12,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="15" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <!-- Editable on purpose: the keyboard opens with the code selected, and its suggestion bar offers Copy. -->
        <TextBox x:Name="CodeBox" Grid.Row="1" Margin="0,24,0,0" FontSize="56" FontWeight="Light"
                 Foreground="#FF4DB6AC" TextAlignment="Center" IsReadOnly="False" />
        <TextBlock x:Name="HintText" Grid.Row="2" Margin="0,12,0,0" FontSize="13" Opacity="0.6" TextWrapping="Wrap" />
        <TextBlock Grid.Row="3" Margin="0,24,0,0" FontSize="12" Opacity="0.5" TextWrapping="Wrap"
                   Text="Il codice è selezionato: usa Copia dalla barra sopra la tastiera, poi torna indietro." />
    </Grid>
</Page>
