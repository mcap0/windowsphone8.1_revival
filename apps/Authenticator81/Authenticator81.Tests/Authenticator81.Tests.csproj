<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs the platform independent OTP code (shared with the WP8.1 app) against the RFC 4226/6238 vectors. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Authenticator81\Core\Otp.cs" Link="Otp.cs" />
  </ItemGroup>
</Project>
