<Page
    x:Class="Telegram.ImagePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">
    <Grid>
        <ScrollViewer x:Name="Scroller" SizeChanged="Scroller_SizeChanged" ZoomMode="Enabled" MinZoomFactor="1" MaxZoomFactor="4"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto">
            <Image x:Name="Photo" Stretch="Uniform" />
        </ScrollViewer>
        <TextBlock x:Name="LoadingText" Text="Caricamento..." FontSize="18"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   />
    </Grid>
    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Save" Label="Salva" Click="Save_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
