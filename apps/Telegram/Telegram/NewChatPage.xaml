<Page
    x:Class="Telegram.NewChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="19,10,19,8">
            <TextBlock Text="TELEGRAM" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource TgBlue}" />
            <TextBlock x:Name="PageTitle" Text="nuova chat" FontSize="30" FontWeight="Light" />
            <TextBox x:Name="Query" Style="{StaticResource DarkBox}" PlaceholderText="Nome o @username" Margin="0,8,0,0"
                     InputScope="Search" TextChanged="Query_TextChanged" KeyUp="Query_KeyUp" />
            <TextBlock x:Name="StatusText" FontSize="14" Foreground="{StaticResource Dim}" Margin="0,6,0,0" />
        </StackPanel>
        <ListView x:Name="People" Grid.Row="1" IsItemClickEnabled="True" ItemClick="People_ItemClick" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="19,6,19,6">
                        <TextBlock Text="{Binding Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" FontSize="14" Foreground="{StaticResource Dim}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
