<Page
    x:Class="Telegram.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <ScrollViewer>
        <StackPanel Margin="16,12,16,16">
            <TextBlock Text="Impostazioni" FontSize="32" FontWeight="SemiBold" />
            <TextBlock x:Name="AccountText" FontSize="18" TextWrapping="Wrap" />
            <Button Content="Invia log al PC" HorizontalAlignment="Stretch" Click="SendLog_Click" />
            <TextBlock Text="Log diagnostico" FontSize="18" Margin="0,8,0,0" />
            <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="220" />
            <Button Content="Esci dall'account" HorizontalAlignment="Stretch"
                    Click="Logout_Click" />
        </StackPanel>
    </ScrollViewer>
</Page>
