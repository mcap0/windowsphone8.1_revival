<Page
    x:Class="Telegram.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="19,10,19,8">
            <TextBlock Text="TELEGRAM" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource TgBlue}" />
            <TextBlock Text="chat" Style="{ThemeResource HeaderTextBlockStyle}" Margin="0,-4,0,0" />
            <TextBlock x:Name="ConnectionStatus" Text="Connessione..." FontSize="14" Foreground="{StaticResource Dim}" />
        </StackPanel>
        <ListView x:Name="ChatList" Grid.Row="1" IsItemClickEnabled="True" ItemClick="ChatList_ItemClick" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="19,7,19,7" Background="Transparent" Holding="Chat_Holding">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="54" Height="54" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Rectangle Fill="{Binding AvatarBrush}" />
                            <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="SemiBold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Title}" FontSize="21" TextTrimming="CharacterEllipsis" Opacity="{Binding TitleOpacity}" />
                            <TextBlock Text="{Binding Preview}" FontSize="16" Foreground="{StaticResource Dim}"
                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Time}" FontSize="13" HorizontalAlignment="Right" Foreground="{StaticResource Dim}" />
                            <Border Background="{Binding BadgeBrush}" MinWidth="24" Height="24" Margin="0,6,0,0"
                                    HorizontalAlignment="Right" Visibility="{Binding UnreadVisibility}">
                                <TextBlock Text="{Binding UnreadText}" FontSize="13" Foreground="White" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="7,0" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
    <Page.BottomAppBar>
        <CommandBar ClosedDisplayMode="Minimal">
            <AppBarButton Icon="Add" Label="nuova chat" Click="NewChat_Click" />
            <AppBarButton Icon="Refresh" Label="aggiorna" Click="Refresh_Click" />
            <AppBarButton Icon="Setting" Label="impostazioni" Click="Settings_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
