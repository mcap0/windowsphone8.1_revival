<Page
    x:Class="Telegram.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Loaded="Page_Loaded"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="19,10,19,6">
            <TextBlock Text="TELEGRAM" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource TgBlue}" />
            <TextBlock x:Name="ChatTitle" Text="chat" FontSize="30" FontWeight="Light" TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <ListView x:Name="MessageList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="False"
                  ScrollViewer.VerticalScrollBarVisibility="Auto" Loaded="MessageList_Loaded">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Background="Transparent" Tapped="Message_Tapped" Holding="Message_Holding">
                        <Border Background="{Binding Background}" Padding="11,6,11,5"
                                Margin="{Binding BubbleMargin}" HorizontalAlignment="{Binding Align}" MinWidth="70">
                            <StackPanel>
                                <TextBlock Text="{Binding Sender}" Visibility="{Binding SenderVisibility}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="{Binding SenderBrush}" TextTrimming="CharacterEllipsis" />
                                <Border Visibility="{Binding ReplyVisibility}" BorderBrush="{StaticResource TgBlue}"
                                        BorderThickness="3,0,0,0" Padding="8,1,0,1" Margin="0,2,0,4">
                                    <TextBlock Text="{Binding Reply}" FontSize="14" Foreground="{StaticResource Dim}"
                                               TextTrimming="CharacterEllipsis" MaxLines="2" TextWrapping="Wrap" />
                                </Border>
                                <Image Source="{Binding Image}" Visibility="{Binding ImageVisibility}" MaxHeight="320"
                                       MaxWidth="300" Stretch="Uniform" HorizontalAlignment="Left" Margin="-5,2,-5,4" />
                                <TextBlock Text="{Binding MediaLabel}" Visibility="{Binding MediaVisibility}" FontSize="17"
                                           FontWeight="SemiBold" Foreground="{StaticResource TgBlue}" TextWrapping="Wrap" Margin="0,2,0,2" />
                                <TextBlock Text="{Binding Text}" Visibility="{Binding TextVisibility}" TextWrapping="Wrap"
                                           FontSize="17" Foreground="White" />
                                <ItemsControl ItemsSource="{Binding Reactions}" Visibility="{Binding ReactionsVisibility}" Margin="0,4,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Background}" Padding="8,2" Margin="0,0,6,0" Tapped="Reaction_Tapped">
                                                <TextBlock Text="{Binding Text}" FontSize="14" Foreground="White" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding Time}" FontSize="12" Foreground="White" Opacity="0.55"
                                           HorizontalAlignment="Right" Margin="12,1,0,0" />
                                <Border Visibility="{Binding CommentsVisibility}" BorderBrush="#40FFFFFF" BorderThickness="0,1,0,0"
                                        Margin="0,4,0,0" Padding="0,6,0,2" Background="Transparent" Tapped="Comments_Tapped">
                                    <TextBlock Text="{Binding CommentsText}" FontSize="16" Foreground="{StaticResource TgBlue}" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Grid x:Name="RecordingBar" Grid.Row="2" Background="#E53935" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="RecordingText" VerticalAlignment="Center" Margin="19,0,8,0" FontSize="17"
                       Text="Registrazione 0:00" TextWrapping="Wrap" Foreground="White" />
            <Button Grid.Column="1" Style="{StaticResource RoundButton}" Background="#40FFFFFF" Margin="4,8"
                    Click="CancelRecording_Click">
                <SymbolIcon Symbol="Cancel" Foreground="White" />
            </Button>
            <Button Grid.Column="2" Style="{StaticResource RoundButton}" Background="White" Margin="4,8,12,8"
                    Click="StopRecording_Click">
                <SymbolIcon Symbol="Send" Foreground="#E53935" />
            </Button>
        </Grid>

        <StackPanel Grid.Row="3" Margin="8,4,8,6">
            <Grid x:Name="ReplyBar" Visibility="Collapsed" Margin="6,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border BorderBrush="{StaticResource TgBlue}" BorderThickness="3,0,0,0" Padding="8,2,0,2">
                    <TextBlock x:Name="ReplyText" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                               FontSize="15" Foreground="{StaticResource Dim}" />
                </Border>
                <Button Grid.Column="1" Style="{StaticResource RoundButton}" Background="Transparent" Click="CancelReply_Click">
                    <SymbolIcon Symbol="Cancel" Foreground="{StaticResource Dim}" />
                </Button>
            </Grid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="Composer" Style="{StaticResource DarkBox}" PlaceholderText="Messaggio" MaxHeight="130"
                         AcceptsReturn="True" TextWrapping="Wrap" InputScope="Chat" VerticalAlignment="Center" />
                <!-- Press + no tab stop: the box keeps focus, so the keyboard does not close and move the button
                     away before the tap is released (that ate the first tap) -->
                <Button Grid.Column="1" Style="{StaticResource RoundButton}" Margin="8,0,0,0" VerticalAlignment="Center"
                        ClickMode="Press" IsTabStop="False" Click="Send_Click">
                    <!-- paper plane, optically centred -->
                    <Path Fill="White" Width="22" Height="20" Stretch="Uniform" Margin="3,0,0,0"
                          Data="M0,0 L24,10 L0,20 L0,12.5 L15,10 L0,7.5 Z" />
                </Button>
            </Grid>
        </StackPanel>

        <MediaElement x:Name="AudioPlayer" Grid.Row="1" AutoPlay="True" Visibility="Collapsed"
                      MediaEnded="AudioPlayer_MediaEnded" />

        <Grid x:Name="AttachmentPreview" Grid.RowSpan="4" Background="#F21A1A1A" Visibility="Collapsed"
              Canvas.ZIndex="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock x:Name="AttachmentCount" Margin="20,18" FontSize="20" Foreground="White"
                       Text="Anteprima allegati" TextWrapping="Wrap" />
            <Image x:Name="AttachmentImage" Grid.Row="1" Margin="12" MaxHeight="420" Stretch="Uniform" />
            <TextBlock x:Name="AttachmentName" Grid.Row="2" Margin="20,8" FontSize="17" Foreground="White"
                       TextWrapping="Wrap" TextAlignment="Center" />
            <!-- four equal columns; MinWidth 0 because the WP8.1 default (109) made the buttons overlap -->
            <Grid Grid.Row="3" Margin="12,8,12,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Content="‹" FontSize="28" MinWidth="0" Padding="0" Margin="0,0,4,0" HorizontalAlignment="Stretch"
                        Click="PreviewPrevious_Click" />
                <Button Grid.Column="1" Content="Annulla" MinWidth="0" Padding="0" Margin="4,0" HorizontalAlignment="Stretch"
                        Click="PreviewCancel_Click" />
                <Button x:Name="PreviewSendButton" Grid.Column="2" Content="Invia" MinWidth="0" Padding="0" Margin="4,0"
                        HorizontalAlignment="Stretch" Background="#229ED9" Foreground="White" Click="PreviewSend_Click" />
                <Button Grid.Column="3" Content="›" FontSize="28" MinWidth="0" Padding="0" Margin="4,0,0,0"
                        HorizontalAlignment="Stretch" Click="PreviewNext_Click" />
            </Grid>
        </Grid>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar ClosedDisplayMode="Minimal">
            <AppBarButton Icon="Camera" Label="foto" Click="Photo_Click" />
            <AppBarButton Icon="Attach" Label="file" Click="File_Click" />
            <AppBarButton Icon="Microphone" Label="vocale" Click="Voice_Click" />
            <AppBarButton x:Name="MuteButton" Icon="Mute" Label="silenzia" Click="Mute_Click" />
        </CommandBar>
    </Page.BottomAppBar>
</Page>
