<Page
    x:Class="Telegram.FilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="19,10,19,8">
            <TextBlock Text="TELEGRAM" Style="{ThemeResource TitleTextBlockStyle}" Foreground="{StaticResource TgBlue}" />
            <TextBlock Text="allega file" FontSize="30" FontWeight="Light" />
            <TextBlock x:Name="PathText" FontSize="14" Foreground="{StaticResource Dim}" TextTrimming="CharacterEllipsis" />
            <Grid Margin="0,8,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SelectionStatus" VerticalAlignment="Center" FontSize="14" Foreground="{StaticResource Dim}"
                           Text="tocca i file da allegare" />
                <Button Grid.Column="1" Content="Anteprima" MinWidth="0" Click="SendSelected_Click" />
            </Grid>
        </StackPanel>
        <!-- SelectionMode Multiple + ItemClick on WP8.1 swallows the taps: selection is kept by hand -->
        <ListView x:Name="Entries" Grid.Row="1" IsItemClickEnabled="True" ItemClick="Entries_ItemClick" SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Margin" Value="0" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="19,6,19,6" Background="{Binding Highlight}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe UI Symbol" FontSize="24" Foreground="{StaticResource TgBlue}"
                                       VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Name}" FontSize="20" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="14" Foreground="{StaticResource Dim}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
