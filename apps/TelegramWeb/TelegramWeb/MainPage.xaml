<Page
    x:Class="TelegramWeb.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF17212B">

    <Grid x:Name="Root">
        <Grid x:Name="WebHost" Background="#FF17212B">
            <!-- In a Canvas (as in MetroSurf): the panel is sized in physical pixels and scaled down by
                 RenderTransform; a Grid would clip it to the logical size before the transform. -->
            <Canvas>
                <SwapChainPanel x:Name="GpuPanel" Visibility="Collapsed" />
            </Canvas>
            <Image x:Name="WebImage" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="Fill" Visibility="Collapsed" />
        </Grid>
        <!-- Hidden text sink: focusing it raises the on-screen keyboard; edits are mirrored into the page. -->
        <TextBox x:Name="KeyboardProxy" Opacity="0" Width="2" Height="2" MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
        <TextBlock x:Name="StatusText" Text="Opening Telegram..." FontSize="20" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
    </Grid>
</Page>
